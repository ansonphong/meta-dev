{
  "$schema": "https://raw.githubusercontent.com/ansonphong/meta-dev/main/plugins/meta-dev/schemas/settings.schema.json",
  "version": "1.0.0",
  "meta_dev": {
    "components": {
      "dashboard": true,
      "overlord": true,
      "changelog": true,
      "versioning": true,
      "review_batch": true,
      "auto_sweep": false,
      "repair_loop": true,
      "classify_hook": true,
      "inbox": true
    },
    "dashboard": {
      "auto_inject_on_session": true,
      "refresh": "normal",
      "show_sweep_log": true,
      "show_inbox": true,
      "show_exec_order": true,
      "show_active_sessions": true
    },
    "inbox": {
      "auto_register_sources": [
        "overlord_finding",
        "review_failure",
        "sweep_anomaly",
        "repair_dossier",
        "classify_blocked",
        "security_alert",
        "plan_ready_review",
        "plan_question",
        "loopgap_done",
        "decision_needed",
        "deploy_gate"
      ],
      "auto_clear_severity": "low",
      "escalate_severity": "high",
      "surface_severity": "critical",
      "clear_default_model": "sonnet",
      "clear_model_override": null,
      "max_open_items": 50,
      "max_overflow_action": "archive_oldest_resolved",
      "stale_days": 14,
      "dedup_window_hours": 72
    },
    "overlord": {
      "trigger": "on_plan_edit",
      "model": "sonnet",
      "auto_fix": "moderate_and_below",
      "auto_clear_inbox_per_tick": true,
      "max_loops": 100
    },
    "changelog": {
      "auto_add_on_commit": true,
      "auto_cut_on": "manual",
      "auto_cut_threshold": 20,
      "version_strategy": "semver",
      "release_post_target": null
    },
    "versioning": {
      "default_strategy": "semver",
      "auto_bump_on_cut": true,
      "git_tag_on_bump": true,
      "push_tags_on_bump": true
    },
    "gates": {
      "low_risk": "auto_execute",
      "medium_risk": "review_after",
      "high_risk": "gate_before_execute"
    },
    "ladder": {
      "pool": [],
      "paused": [],
      "native_only_when_required": false
    },
    "paths": {
      "plans_root": "plans",
      "plan_subdirs": [],
      "archive_subdir": "_archive",
      "design_doc": null,
      "learned_patterns": null,
      "exec_order": "plans/exec-order.md",
      "status_file": "plans/STATUS.md"
    },
    "models": {
      "stage_overrides": {},
      "default_model": null
    },
    "workflow": {
      "plan_target": "auto",
      "execution_granularity": "auto",
      "research_depth": "auto",
      "hardening_depth": "auto",
      "cross_family_review": false,
      "max_tasks_per_slice": 3,
      "max_parallel_workers": 4,
      "focused_max_reviewers": 1,
      "full_max_reviewers": 4,
      "max_review_rounds": 2,
      "host_execute_models": {},
      "host_capabilities": {},
      "sensitive_risks": ["auth", "authorization", "security", "payment", "payments", "migration", "cross-service", "destructive", "high", "critical"],
      "model_profiles": {
        "gpt-6-astra": {"plan_target": "lean", "coherent_slices": true},
        "gpt-5.6-sol": {"plan_target": "lean", "coherent_slices": true},
        "claude-opus-4-8": {"plan_target": "lean", "coherent_slices": true},
        "claude-opus-5": {"plan_target": "lean", "coherent_slices": true},
        "grok-4.6": {"plan_target": "lean", "coherent_slices": true},
        "gpt-5.6-terra": {"plan_target": "standard", "coherent_slices": false},
        "claude-sonnet-5": {"plan_target": "standard", "coherent_slices": false},
        "gpt-5.6-luna": {"plan_target": "explicit", "coherent_slices": false},
        "gpt-5.3-codex-spark": {"plan_target": "explicit", "coherent_slices": false},
        "haiku": {"plan_target": "explicit", "coherent_slices": false}
      },
      "model_aliases": {
        "astra": "gpt-6-astra",
        "spark": "gpt-5.3-codex-spark",
        "sol": "gpt-5.6-sol",
        "gpt-5.6": "gpt-5.6-sol",
        "terra": "gpt-5.6-terra",
        "luna": "gpt-5.6-luna",
        "opus-4.8": "claude-opus-4-8",
        "claude-opus-4.8": "claude-opus-4-8",
        "opus-5": "claude-opus-5",
        "grok-4-6": "grok-4.6",
        "sonnet-5": "claude-sonnet-5"
      }
    },
    "context": {
      "context_window": null,
      "threshold": null,
      "threshold_ratio": 0.8,
      "model_windows": {}
    },
    "codex": {
      "models": {
        "plan": {
          "tier": "sol",
          "effort": "high"
        },
        "harden": {
          "tier": "sol",
          "effort": "high"
        },
        "review": {
          "tier": "sol",
          "effort": "high"
        },
        "execute": {
          "tier": "terra",
          "effort": "medium"
        },
        "lightweight": {
          "tier": "terra",
          "effort": "low"
        },
        "mechanical": {
          "tier": "spark",
          "effort": "low"
        }
      },
      "reviewer": "native",
      "compat_router": true
    },
    "filesystem": {
      "git_corruption_mitigations": {
        "core_filemode": false,
        "core_preloadindex": false,
        "core_untrackedcache": false,
        "core_fsmonitor": false
      },
      "wsl_detection": "auto"
    },
    "guard": {
      "scope_root": ".",
      "destructive_categories": {
        "rm_rf_non_temp": "block",
        "rm_git_index": "block",
        "git_reset_hard": "block",
        "git_checkout_dot": "block",
        "git_add_sweep": "block",
        "git_push_force_main": "block",
        "no_verify_flag": "warn",
        "drop_table": "block"
      }
    },
    "eval": {
      "health_checks": [],
      "max_rounds": 3,
      "grade_threshold": "B"
    },
    "canary": {
      "default_target": "default",
      "default_duration": "10m",
      "interval": {
        "divisor": 10,
        "min_seconds": 30,
        "max_seconds": 120
      },
      "baseline": {
        "enabled": true,
        "latency_multiplier": 2.0
      },
      "escalation": {
        "strike_count": 3
      },
      "errors": {
        "warn_threshold": 0,
        "fail_threshold": 5
      },
      "ssl_dns": {
        "enabled": true,
        "cert_expiry_warn_days": 7
      },
      "targets": {}
    },
    "init_check": {
      "total_budget_seconds": 30,
      "default_check_timeout_seconds": 10,
      "repos": [],
      "services": [],
      "test_baseline": {
        "command": "",
        "pass": "exit_zero",
        "timeout_seconds": 15
      },
      "frontend": {
        "deps_dir": "",
        "typecheck_command": "",
        "native_toolchain": []
      },
      "api_contract": {
        "enabled": true,
        "frontend_call_patterns": [],
        "backend_route_patterns": []
      },
      "env_files": [
        ".env"
      ]
    },
    "security": {
      "confidence_threshold": 0.8,
      "always_checked_invariants": [],
      "scope_phase_groups": {
        "auth": [
          1,
          2,
          6
        ],
        "payment": [
          1,
          4,
          8
        ],
        "all": [
          1,
          2,
          3,
          4,
          5,
          6,
          7,
          8,
          9
        ]
      },
      "model_tiers": {
        "group_a_identity": "sonnet",
        "group_b_input_infra": "sonnet",
        "group_c_secrets_crypto_exposure": "sonnet",
        "phase_8_crypto": "opus",
        "group_d_value_paths": "opus",
        "findings_synthesis": "opus"
      }
    },
    "ux": {
      "default_depth": "standard",
      "default_rounds": 1,
      "grade_threshold": "B",
      "fix_min_severity": "high",
      "domain_context": null,
      "focus_areas": [],
      "design_system_rules": [],
      "scoring": {
        "first_principles": 30,
        "design_compliance": 30,
        "accessibility": 20,
        "coherence": 20
      }
    },
    "review_design": {
      "design_doc": null,
      "token_map": {},
      "default_token_namespace": "default",
      "target_globs": [
        "*.svelte",
        "*.css",
        "*.postcss",
        "*.html",
        "*.tsx",
        "*.jsx",
        "*.vue"
      ],
      "diff_base": "HEAD~1",
      "depth": "standard",
      "accent_color": null,
      "craft_heuristic": {
        "forbidden": [],
        "deduction": 1,
        "dimension": "craft"
      },
      "slop_patterns": {
        "generic_gradients": true,
        "hero_stock_phrases": true,
        "identical_card_grids": true,
        "unstyled_component_libs": true,
        "excessive_loaders": true,
        "placeholder_content": true,
        "generic_ctas": true,
        "no_type_hierarchy": true,
        "craft_heuristic": true,
        "stock_photos": true
      },
      "scoring": {
        "weights": {
          "coherence": 0.3,
          "originality": 0.25,
          "craft": 0.25,
          "functionality": 0.2
        },
        "grade_threshold": "B"
      }
    },
    "execute": {
      "test_policy": "critical-only",
      "risk_keywords": {
        "schema_drift": [],
        "security_boundary": [],
        "release_stability": [],
        "money_path": [],
        "perf_cache": []
      }
    }
  }
}
