{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/ansonphong/meta-dev/main/plugins/meta-dev/schemas/plan-artifact.schema.json",
  "title": "Meta-Dev Plan Artifact IR",
  "description": "Versioned, host-neutral input for plan-artifact-render.py. All path values are project-relative POSIX paths.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "layout", "artifact_path", "title", "slug", "repo", "stage", "context", "docs", "depends", "blocks", "why", "files", "acceptance", "loop_gap_baseline"],
  "properties": {
    "version": { "const": "1.0" },
    "layout": { "enum": ["multi-phase", "single-file"] },
    "artifact_path": { "type": "string", "minLength": 1, "description": "Multi-phase: output directory. Single-file: output .md file." },
    "title": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "repo": { "enum": ["app", "www", "gallery", "meta"] },
    "stage": { "type": "integer", "minimum": 1, "maximum": 6 },
    "context": { "$ref": "#/definitions/pathList" },
    "docs": { "$ref": "#/definitions/pathList" },
    "depends": { "$ref": "#/definitions/pathList" },
    "blocks": { "$ref": "#/definitions/pathList" },
    "why": { "type": "string", "minLength": 1 },
    "files": { "type": "array", "items": { "$ref": "#/definitions/file" } },
    "acceptance": { "$ref": "#/definitions/textList" },
    "loop_gap_baseline": { "$ref": "#/definitions/loopGapBaseline" },
    "phases": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/phase" } },
    "tasks": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/task" } }
  },
  "allOf": [
    {
      "if": { "properties": { "layout": { "const": "multi-phase" } } },
      "then": { "required": ["phases"], "not": { "required": ["tasks"] } }
    },
    {
      "if": { "properties": { "layout": { "const": "single-file" } } },
      "then": { "required": ["tasks"], "not": { "required": ["phases"] } }
    }
  ],
  "definitions": {
    "pathList": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "textList": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "action", "purpose"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "action": { "enum": ["create", "modify", "delete", "move"] },
        "purpose": { "type": "string", "minLength": 1 }
      }
    },
    "verify": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "scope"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["focused", "scoped_check"] }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handle", "title", "description", "test", "dependencies", "files", "acceptance", "verify_after"],
      "properties": {
        "handle": { "type": "string", "pattern": "^T[A-Za-z0-9]+\\.[0-9]+$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "test": { "type": "boolean" },
        "dependencies": { "$ref": "#/definitions/textList" },
        "files": { "$ref": "#/definitions/pathList" },
        "acceptance": { "$ref": "#/definitions/textList" },
        "verify_after": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/verify" } }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "tasks"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9]+$" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "tasks": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/task" } }
      }
    },
    "loopGapBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "signatures", "affected_files", "prioritized_gaps"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "signatures": { "$ref": "#/definitions/textList" },
        "affected_files": { "$ref": "#/definitions/pathList" },
        "prioritized_gaps": { "$ref": "#/definitions/textList" }
      }
    }
  }
}
