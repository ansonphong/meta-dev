{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/ansonphong/meta-dev/main/plugins/meta-dev/schemas/plan-artifact.schema.json",
  "title": "Meta-Dev Plan Artifact IR",
  "description": "Versioned, host-neutral input for plan-artifact-render.py. Version 1.0 preserves the shared Claude/multi-phase contract. Version 1.1 is the native Codex execution-grade single-file contract. Path values are POSIX paths relative to the owning root unless a field says otherwise.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "layout",
    "artifact_path",
    "title",
    "slug",
    "repo",
    "stage",
    "context",
    "docs",
    "depends",
    "blocks",
    "why",
    "files",
    "acceptance"
  ],
  "properties": {
    "version": { "enum": ["1.0", "1.1"] },
    "layout": { "enum": ["multi-phase", "single-file"] },
    "artifact_path": { "type": "string", "minLength": 1, "description": "Multi-phase: output directory. Single-file: output .md file. Must be below plans/<repo>/ with the same repo segment; enforced by the renderer." },
    "title": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "repo": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "stage": { "type": "integer", "minimum": 1, "maximum": 6 },
    "target": {
      "enum": ["lean", "standard", "explicit"],
      "description": "Authoring depth tier, scaled to the capability of the executing agent. Optional; absent means 'standard'. Tier meanings, the tier-to-backend mapping, and the blast-radius override are defined once in references/plan-targets.md."
    },
    "context": { "$ref": "#/definitions/pathList" },
    "docs": { "$ref": "#/definitions/pathList" },
    "depends": { "$ref": "#/definitions/pathList" },
    "blocks": { "$ref": "#/definitions/pathList" },
    "why": { "type": "string", "minLength": 1 },
    "files": { "type": "array", "items": { "$ref": "#/definitions/file" } },
    "acceptance": { "$ref": "#/definitions/textList" },
    "loop_gap_baseline": { "$ref": "#/definitions/loopGapBaseline" },
    "phases": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/phaseV10" } },
    "tasks": { "type": "array", "minItems": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "architecture": { "type": "string", "minLength": 1 },
    "tech_stack": { "$ref": "#/definitions/richTextList" },
    "global_constraints": { "$ref": "#/definitions/richTextList" },
    "codebase_snapshot": { "$ref": "#/definitions/codebaseSnapshot" },
    "decisions": { "$ref": "#/definitions/richTextList" },
    "non_goals": { "$ref": "#/definitions/richTextList" },
    "failure_modes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/failureMode" }
    },
    "blast_radius": { "$ref": "#/definitions/richTextList" },
    "rollback": { "$ref": "#/definitions/richTextList" }
  },
  "allOf": [
    {
      "if": {
        "required": ["version"],
        "properties": { "version": { "const": "1.0" } }
      },
      "then": {
        "required": ["loop_gap_baseline"],
        "allOf": [
          {
            "if": { "properties": { "layout": { "const": "multi-phase" } } },
            "then": { "required": ["phases"], "not": { "required": ["tasks"] } }
          },
          {
            "if": { "properties": { "layout": { "const": "single-file" } } },
            "then": {
              "required": ["tasks"],
              "not": { "required": ["phases"] },
              "properties": {
                "tasks": {
                  "items": { "$ref": "#/definitions/taskV10" }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "required": ["version"],
        "properties": { "version": { "const": "1.1" } }
      },
      "then": {
        "required": [
          "tasks",
          "goal",
          "architecture",
          "tech_stack",
          "global_constraints",
          "codebase_snapshot",
          "decisions",
          "non_goals",
          "failure_modes",
          "blast_radius",
          "rollback"
        ],
        "properties": {
          "layout": { "const": "single-file" },
          "artifact_path": {
            "pattern": "^plans/[a-z0-9]+(?:-[a-z0-9]+)*/[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*\\.md$"
          },
          "tasks": {
            "items": { "$ref": "#/definitions/taskV11" }
          }
        },
        "not": {
          "anyOf": [
            { "required": ["phases"] },
            { "required": ["loop_gap_baseline"] }
          ]
        }
      }
    }
  ],
  "definitions": {
    "pathList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "textList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "richTextList": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "action", "purpose"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "action": { "enum": ["create", "modify", "delete", "move"] },
        "purpose": { "type": "string", "minLength": 1 }
      }
    },
    "verifyV10": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "scope"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["focused", "scoped_check"] }
      }
    },
    "verifyV11": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "scope", "expected"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["focused", "scoped_check"] },
        "expected": { "type": "string", "minLength": 1 }
      }
    },
    "taskV10": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handle", "title", "description", "test", "dependencies", "files", "acceptance", "verify_after"],
      "properties": {
        "handle": { "type": "string", "pattern": "^T[A-Za-z0-9]+\\.[0-9]+$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "test": { "type": "boolean" },
        "dependencies": { "$ref": "#/definitions/textList" },
        "files": { "$ref": "#/definitions/pathList" },
        "acceptance": { "$ref": "#/definitions/textList" },
        "verify_after": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/verifyV10" }
        }
      }
    },
    "taskFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "action", "purpose", "anchors"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "action": { "enum": ["create", "modify", "delete", "move"] },
        "purpose": { "type": "string", "minLength": 1 },
        "anchors": { "$ref": "#/definitions/richTextList" }
      }
    },
    "interfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumes", "produces"],
      "properties": {
        "consumes": { "$ref": "#/definitions/textList" },
        "produces": { "$ref": "#/definitions/textList" }
      }
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo_root", "message", "files"],
      "properties": {
        "repo_root": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "taskV11": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handle",
        "title",
        "objective",
        "context",
        "test",
        "dependencies",
        "files",
        "interfaces",
        "steps",
        "acceptance",
        "verify_before",
        "verify_after",
        "commit"
      ],
      "properties": {
        "handle": { "type": "string", "pattern": "^T[A-Za-z0-9]+\\.[0-9]+$" },
        "title": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "context": { "$ref": "#/definitions/richTextList" },
        "test": { "type": "boolean" },
        "dependencies": { "$ref": "#/definitions/textList" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/taskFile" }
        },
        "interfaces": { "$ref": "#/definitions/interfaces" },
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "acceptance": { "$ref": "#/definitions/richTextList" },
        "verify_before": {
          "type": "array",
          "items": { "$ref": "#/definitions/verifyV11" }
        },
        "verify_after": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/verifyV11" }
        },
        "commit": { "$ref": "#/definitions/commit" }
      }
    },
    "phaseV10": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "tasks"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9]+$" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/taskV10" }
        }
      }
    },
    "loopGapBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "signatures", "affected_files", "prioritized_gaps"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "signatures": { "$ref": "#/definitions/textList" },
        "affected_files": { "$ref": "#/definitions/pathList" },
        "prioritized_gaps": { "$ref": "#/definitions/textList" }
      }
    },
    "codebaseSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "current_behavior", "anchors", "data_flow"],
      "properties": {
        "revision": { "type": "string", "minLength": 1 },
        "current_behavior": { "$ref": "#/definitions/richTextList" },
        "anchors": { "$ref": "#/definitions/richTextList" },
        "data_flow": { "$ref": "#/definitions/richTextList" }
      }
    },
    "failureMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure", "handling"],
      "properties": {
        "failure": { "type": "string", "minLength": 1 },
        "handling": { "type": "string", "minLength": 1 }
      }
    }
  }
}
