#!/usr/bin/env bash
# ============================================================================
# cursor-headless-exec — Execute a task via headless Cursor Agent CLI
#                       (`cursor-agent --print --output-format json`), emitting
#                       the SAME clean result contract as grok/codex/agy.
#
# Cursor is its OWN agent harness (NOT Claude Code, NOT Grok Build). Default
# model is pinned to the Cursor Models pool (Composer 2.5 / Cursor Grok 4.6)
# so the TUI last-used model cannot leak (often a 1M Other-Models id).
#
# Usage:
#   cursor-headless-exec [options] -- <prompt>
#
# Options:
#   --repo <name>            Resolve via topology config; unresolvable => abort.
#                            Omit to run at the PROJECT ROOT (never the caller's cwd).
#   --model <id>             Raw cursor-agent catalog id (wins over aliases)
#   --composer               Composer 2.5 (Cursor Models pool, 200k)
#   --grok [4.5|4.6|4.7] [effort]
#                            Cursor Grok (pool, 256k). 4.7 ids are grok-4.7-<effort>.
#                            Example: --grok 4.7 xhigh
#   --opus / --sol / --sonnet / --luna / --fable / --codex
#                            Other Models pool aliases (usually 1M)
#   --effort <level>         Family effort (grok: low|medium|high|xhigh)
#   --context 256k|500k      Grok 4.7 only. Omit or 256k keeps grok-4.7-<effort>.
#                            500k sends grok-4.7[context=500k,reasoning_effort=...,fast=...].
#   --fast                   Append the catalog -fast variant when it exists
#   --shape collect|ordinary|hard
#                            Chooser hint when no model/alias is named
#   --budget auto|low|medium|high
#   --timeout <ms>           Wall-clock timeout (default: from --budget)
#   --readonly               --mode ask (read-only Q&A)
#   --resolve-only           Print the resolved catalog id and exit (no CLI)
#   --output json|text       Output format (default: json)
#   --output-file <path>     Write distilled JSON here
#   --prompt-file <path>     Read the prompt from a file (AUTHORITATIVE)
#   -h, --help               Show this help
#
# Prerequisites: `cursor-agent` on PATH (or ~/.local/bin/cursor-agent),
# authenticated (`cursor-agent login` → ~/.config/cursor/auth.json).
# ============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/plugin-root.sh
source "$SCRIPT_DIR/lib/plugin-root.sh"
PLUGIN_ROOT="$(_md_plugin_root)"

REPO=""
MODEL=""
MODEL_EXPLICIT=0
FAMILY=""
GROK_VER=""
FAST=0
CONTEXT=""
SHAPE=""
EFFORT=""
EFFORT_EXPLICIT=0
MAX_TURNS=""
MAX_TURNS_EXPLICIT=0
TIMEOUT="5400000"
TIMEOUT_EXPLICIT=0
BUDGET="auto"
READONLY=false
RESOLVE_ONLY=false
OUTPUT_FORMAT="json"
PROMPT=""
PROMPT_INPUT_FILE=""
OUTPUT_FILE=""

show_help() {
    cat <<'EOF'
cursor-headless-exec — Execute a task via headless Cursor Agent (`cursor-agent`)

Usage:
  cursor-headless-exec [options] -- <prompt>

Launches: cursor-agent --print --output-format json --trust --workspace <repo>
          --model <id> [--force | --mode ask]

Options:
  --repo <name>            Resolve via .claude/meta-dev-repos.json; unknown ABORTS.
                           Omit => project root (not cwd).
  --model <id>             Raw catalog id (wins over aliases)
  --composer               Composer 2.5 (Cursor Models pool, 200k context)
  --grok [4.5|4.6|4.7] [effort]
                           Cursor Grok (pool, 256k standard). 4.6/4.5 ids are
                           cursor-grok-<ver>-<effort>. 4.7 ids are grok-4.7-<effort>.
                           Example: --grok 4.7 xhigh. Add 500k or --context 500k for the long window.
  --opus                   Claude Opus 5 thinking (Other Models, 1M)
  --sol                    GPT-5.6 Sol (Other Models, 1M)
  --sonnet                 Claude Sonnet 5 thinking (Other Models, 1M)
  --luna                   GPT-5.6 Luna (Other Models, 1M)
  --fable                  Claude Fable 5 thinking (Other Models, 1M)
  --codex                  GPT-5.3 Codex (Other Models)
  --effort <level>         low|medium|high|xhigh|max|none (family-dependent)
  --context 256k|500k      Grok 4.7 only. 500k is opt-in long context.
                           Omit keeps the 256k id grok-4.7-<effort>.
  --fast                   Use the catalog -fast variant when it exists
  --shape collect|ordinary|hard
                           Default chooser when no alias/--model is given
  --budget auto|low|medium|high
                           Depth cap (default auto → medium at the runner).
  --timeout <ms>           Wall-clock timeout in ms (default: from --budget)
  --readonly               Ask mode — read-only Q&A (audits/reviews)
  --resolve-only           Print resolved catalog id and exit (no cursor-agent)
  --output json|text       Output format (default: json)
  --output-file <path>     Write distilled JSON here
  --prompt-file <path>     Read the prompt from a file (AUTHORITATIVE)
  -h, --help               Show this help

Default (no --model / alias): Cursor Models pool — composer-2.5 on budget
low / collect; cursor-grok-4.6-high on ordinary; cursor-grok-4.6-xhigh on
hard / budget high. Never auto-picks Opus/Sol. Named-only — never pooled.

Emits {is_error, subtype, num_turns, duration_ms, session_id, result, usage,
backend, stop_reason} so /auto-execute --cursor consumes this worker
identically to grok/deep/codex/agy.

Prerequisites: cursor-agent on PATH + `cursor-agent login`.
EOF
    exit 0
}

_set_family() {
    local name="$1"
    if [[ -n "$FAMILY" && "$FAMILY" != "$name" ]]; then
        echo "[ERROR] cursor-headless-exec: --composer/--grok/--opus/--sol/--sonnet/--luna/--fable/--codex are exclusive (got: $FAMILY and $name)." >&2
        exit 2
    fi
    FAMILY="$name"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --repo)        REPO="$2"; shift 2 ;;
        --model)       MODEL="$2"; MODEL_EXPLICIT=1; shift 2 ;;
        --composer)    _set_family composer; shift ;;
        --grok)
            _set_family grok
            shift
            if [[ "${1:-}" == "4.5" || "${1:-}" == "4.6" || "${1:-}" == "4.7" ]]; then
                GROK_VER="$1"; shift
            fi
            # Effort and 256k/500k may arrive in either order after the version
            # (`--grok 4.7 500K`, `--grok 4.7 xhigh 500k`).
            for _ in 1 2; do
                case "${1:-}" in
                    none|minimal|low|medium|high|xhigh|max)
                        EFFORT="$1"; EFFORT_EXPLICIT=1; shift ;;
                    256k|256K|500k|500K)
                        CONTEXT="${1,,}"; shift ;;
                    *) break ;;
                esac
            done
            ;;
        --opus)        _set_family opus; shift ;;
        --sol)         _set_family sol; shift ;;
        --sonnet)      _set_family sonnet; shift ;;
        --luna)        _set_family luna; shift ;;
        --fable)       _set_family fable; shift ;;
        --codex)       _set_family codex; shift ;;
        --fast)        FAST=1; shift ;;
        --context)
            CONTEXT="${2,,}"
            shift 2
            ;;
        --shape)       SHAPE="$2"; shift 2 ;;
        --effort)      EFFORT="$2"; EFFORT_EXPLICIT=1; shift 2 ;;
        --budget)      BUDGET="$2"; shift 2 ;;
        --max-turns)   MAX_TURNS="$2"; MAX_TURNS_EXPLICIT=1; shift 2 ;;
        --timeout)     TIMEOUT="$2"; TIMEOUT_EXPLICIT=1; shift 2 ;;
        --readonly)    READONLY=true; shift ;;
        --resolve-only) RESOLVE_ONLY=true; shift ;;
        --output)      OUTPUT_FORMAT="$2"; shift 2 ;;
        --output-file) OUTPUT_FILE="$2"; shift 2 ;;
        --prompt-file) PROMPT_INPUT_FILE="$2"; shift 2 ;;
        -h|--help)     show_help ;;
        --)            shift; PROMPT="$*"; break ;;
        *)             PROMPT="$*"; break ;;
    esac
done

if [[ "$RESOLVE_ONLY" != "true" ]]; then
    source "$SCRIPT_DIR/lib/read-prompt.sh"
    resolve_prompt "$PROMPT_INPUT_FILE" "cursor-headless-exec"
fi

# shellcheck source=lib/execute-budget.sh
source "$SCRIPT_DIR/lib/execute-budget.sh"
# shellcheck source=lib/execute-brief.sh
source "$SCRIPT_DIR/lib/execute-brief.sh"
BACKEND="cursor"
if [[ "$RESOLVE_ONLY" == "true" && -z "${PROMPT:-}" ]]; then
    PROMPT="resolve-only"
fi
md_resolve_budget || exit 1
if [[ "$RESOLVE_ONLY" != "true" ]]; then
    md_budget_wrap_prompt
    md_brief_wrap_prompt
fi

RESOLVE_ARGS=(python3 "$SCRIPT_DIR/lib/cursor-model-resolve.py")
[[ "$MODEL_EXPLICIT" -eq 1 && -n "$MODEL" ]] && RESOLVE_ARGS+=(--model "$MODEL")
[[ -n "$FAMILY" ]] && RESOLVE_ARGS+=(--family "$FAMILY")
[[ -n "$GROK_VER" ]] && RESOLVE_ARGS+=(--grok-version "$GROK_VER")
[[ -n "$EFFORT" ]] && RESOLVE_ARGS+=(--effort "$EFFORT")
[[ "$FAST" -eq 1 ]] && RESOLVE_ARGS+=(--fast)
[[ -n "$CONTEXT" ]] && RESOLVE_ARGS+=(--context "$CONTEXT")
[[ -n "$SHAPE" ]] && RESOLVE_ARGS+=(--shape "$SHAPE")
[[ -n "${BUDGET_RESOLVED:-}" ]] && RESOLVE_ARGS+=(--budget "$BUDGET_RESOLVED")
MODEL="$("${RESOLVE_ARGS[@]}")" || exit $?

if [[ "$RESOLVE_ONLY" == "true" ]]; then
    printf '%s\n' "$MODEL"
    exit 0
fi

CURSOR_BIN="$(command -v cursor-agent 2>/dev/null || true)"
if [[ -z "$CURSOR_BIN" && -x "${HOME}/.local/bin/cursor-agent" ]]; then
    CURSOR_BIN="${HOME}/.local/bin/cursor-agent"
fi
if [[ -z "$CURSOR_BIN" ]]; then
    echo "[ERROR] 'cursor-agent' CLI not found on PATH (also checked ~/.local/bin/cursor-agent)." >&2
    echo "        Install Cursor Agent, then authenticate: cursor-agent login" >&2
    exit 1
fi

AUTH_JSON="$("$CURSOR_BIN" status --format json 2>/dev/null || true)"
if ! python3 -c 'import json,sys; d=json.loads(sys.argv[1] or "{}"); sys.exit(0 if d.get("isAuthenticated") else 1)' "$AUTH_JSON" 2>/dev/null; then
    echo "[ERROR] cursor-agent is not authenticated (status isAuthenticated != true)." >&2
    echo "        Run: cursor-agent login" >&2
    echo "        Aborting without a billed run." >&2
    exit 2
fi

source "$SCRIPT_DIR/lib/resolve-workdir.sh"
resolve_workdir

if [[ -z "$OUTPUT_FILE" ]]; then
    TIMESTAMP=$(date +%Y%m%d-%H%M%S)
    OUTPUT_FILE="/tmp/claude-headless-cursor-${TIMESTAMP}-$$.json"
fi
RAW_FILE="${OUTPUT_FILE}.raw"
STDERR_FILE="${OUTPUT_FILE}.stderr"
PROMPT_FILE="${OUTPUT_FILE}.prompt"
umask 077

TIMEOUT_S=$(( TIMEOUT / 1000 ))
[[ "$TIMEOUT_S" -lt 1 ]] && TIMEOUT_S=1

MODE_DESC="execute (--force --trust)"
[[ "$READONLY" == "true" ]] && MODE_DESC="read-only (--mode ask, no --force)"
cat <<EOF

╔══════════════════════════════════════════════════════════════════════════╗
║  HEADLESS EXECUTION — Cursor Agent (cursor-agent)
╠══════════════════════════════════════════════════════════════════════════╣
║  Backend   : Cursor
║  Model     : ${MODEL}
║  Effort    : ${EFFORT:-n/a (baked into catalog id)}
║  Budget    : ${BUDGET_RESOLVED:-medium} (turns ${MAX_TURNS:-n/a — cursor-agent has no --max-turns})
║  Repo      : ${REPO}
║  Resolved  : ${WORKDIR_ORIGIN}
║  Work Dir  : ${WORK_DIR}
║  Mode      : ${MODE_DESC}
║  Timeout   : ${TIMEOUT}ms (${TIMEOUT_S}s)
║  Output    : ${OUTPUT_FILE}
╠══════════════════════════════════════════════════════════════════════════╣
║  Task:
║    ${PROMPT:0:70}...
╚══════════════════════════════════════════════════════════════════════════╝

EOF

echo "[cursor-headless-exec] Starting headless Cursor ($CURSOR_BIN)..."
echo "[cursor-headless-exec] Working directory: $WORK_DIR"
echo "[cursor-headless-exec] Output file: $OUTPUT_FILE"
echo ""

cd "$WORK_DIR"
printf '%s' "$PROMPT" > "$PROMPT_FILE"

# --print is boolean; prompt is positional. Always pass --model so TUI last
# model cannot leak. --trust skips the workspace prompt.
CURSOR_ARGS=(
    --print
    --output-format json
    --trust
    --workspace "$WORK_DIR"
    --sandbox disabled
    --model "$MODEL"
)
if [[ "$READONLY" == "true" ]]; then
    CURSOR_ARGS+=(--mode ask)
else
    CURSOR_ARGS+=(--force)
fi
CURSOR_ARGS+=(-- "$PROMPT")

_now_ms() {
    local t
    if command -v gdate >/dev/null 2>&1; then t=$(gdate +%s%3N 2>/dev/null)
    else t=$(date +%s%3N 2>/dev/null); fi
    case "$t" in
        ''|*[!0-9]*) t=$(python3 -c 'import time;print(int(time.time()*1000))' 2>/dev/null || echo "$(( $(date +%s) * 1000 ))") ;;
    esac
    printf '%s' "$t"
}

START_TIME=$(_now_ms)
set +e
timeout "${TIMEOUT_S}s" "$CURSOR_BIN" "${CURSOR_ARGS[@]}" \
    > "$RAW_FILE" 2> "$STDERR_FILE"
EXIT_CODE=$?
set -e
END_TIME=$(_now_ms)
ELAPSED_MS=$(( END_TIME - START_TIME ))
ELAPSED_S=$(( ELAPSED_MS / 1000 ))

if [[ $EXIT_CODE -eq 124 ]]; then
    echo "[WARN] cursor-agent timed out after ${TIMEOUT_S}s." >> "$STDERR_FILE"
fi

RESULT_TEXT=""
IS_ERROR="unknown"
PARSE_OK=false
if [[ "$OUTPUT_FORMAT" == "json" ]]; then
    if RESULT_TEXT=$(python3 "$SCRIPT_DIR/lib/distill-cursor-result.py" \
            "$RAW_FILE" "$OUTPUT_FILE" "$EXIT_CODE" "$ELAPSED_MS" \
            2>>"$STDERR_FILE"); then
        PARSE_OK=true
        IS_ERROR=$(python3 -c "import json,sys; print(json.load(open(sys.argv[1])).get('is_error'))" "$OUTPUT_FILE" 2>/dev/null || echo unknown)
    fi
fi
if [[ "$PARSE_OK" != "true" ]]; then
    # The distiller writes a useful error contract even when raw Cursor output
    # is empty/malformed; preserve it rather than replacing it with raw bytes.
    if [[ ! -s "$OUTPUT_FILE" ]]; then
        cp "$RAW_FILE" "$OUTPUT_FILE" 2>/dev/null || true
    fi
    if [[ "$OUTPUT_FORMAT" == "json" ]]; then
        RESULT_TEXT="[distill failed — inspect raw payload: $RAW_FILE / stderr: $STDERR_FILE]"
        [[ $EXIT_CODE -eq 0 ]] && EXIT_CODE=3
    else
        RESULT_TEXT="$(cat "$RAW_FILE" 2>/dev/null || true)"
    fi
fi
chmod 600 "$OUTPUT_FILE" "$RAW_FILE" "$STDERR_FILE" "$PROMPT_FILE" 2>/dev/null || true

if [[ "$IS_ERROR" == "True" && $EXIT_CODE -eq 0 ]]; then
    EXIT_CODE=4
fi

echo ""
echo "────────────────────────────────────────────────────────────────────────"
echo "  HEADLESS EXECUTION COMPLETE"
echo "────────────────────────────────────────────────────────────────────────"
echo "  Backend   : Cursor (${MODEL})"
echo "  Exit code : $EXIT_CODE"
echo "  is_error  : $IS_ERROR"
echo "  Elapsed   : ${ELAPSED_S}s"
echo "  Result    : $OUTPUT_FILE   (clean JSON — result/is_error/session_id/stop_reason)"
echo "  Raw trace : $RAW_FILE"
echo "  Stderr    : $STDERR_FILE"
echo "────────────────────────────────────────────────────────────────────────"

if [[ $EXIT_CODE -ne 0 ]]; then
    echo ""
    echo "[WARN] Headless execution exit code $EXIT_CODE (is_error=$IS_ERROR)."
    echo "       Inspect: $STDERR_FILE"
fi

echo ""
echo "════════════════════════ RESULT ════════════════════════════════════════"
printf '%s\n' "$RESULT_TEXT"
echo "═════════════════════════════════════════════════════════════════════════"
echo "OUTPUT_FILE=$OUTPUT_FILE"

exit $EXIT_CODE
