#!/usr/bin/env bash
# ============================================================================
# codex-headless-exec — Execute a task via headless OpenAI Codex CLI
#                       (`codex exec`), emitting the SAME clean result
#                       contract as claude-headless-exec so /auto-execute can
#                       consume codex workers identically to deep/glm.
#
# Codex is its OWN agent harness (not Claude Code on an Anthropic endpoint),
# so this is a separate runner — but the OUTPUT_FILE contract is identical:
#   {is_error, subtype, num_turns, duration_ms, session_id, result, usage}
#
# Usage:
#   codex-headless-exec [options] -- <prompt>
#
# Options:
#   --repo <name>            Resolve via topology config; unresolvable => abort.
#                            Omit to run at the PROJECT ROOT (never the caller's cwd).
#   --tier <tier>            GPT routing tier: terra | sol (configured roles);
#                            spark | luna remain explicit legacy compatibility tiers.
#                            (fallback default: terra — but CHOOSE, don't inherit)
#
#   Terra is the configured execution/default role (medium; low for lightweight
#   work). Sol is the configured high-judgment role (plan/harden/review). Spark
#   and Luna are retained only for callers that explicitly request legacy tiers;
#   they are never the modern default.
#   --effort <level>         Reasoning: none | low | medium | high | xhigh | max
#                            (default follows tier; terra = medium)
#   --model <model>          Explicit model override; wins over --tier
#   --timeout <ms>           Wall-clock timeout in ms (default: 7200000 = 120 min)
#
# Liveness watchdog (env knobs — a wedged worker that goes silent is killed and
# auto-reset, instead of idling out the full 120-min cap):
#   STALL_SECS=<s>           No RAW-output growth for this long → stuck; kill +
#                            auto-reset (default 300 = 5 min; 0 disables)
#   STALL_MAX_RESETS=<n>     Auto-resets before halt-and-pause (default 3); on
#                            exhaustion the run STOPS with exit 125 for review
#   STALL_POLL_SECS=<s>      Output-size poll interval (default 30)
#   --readonly               Sandbox = read-only (audits / gap-checks / reviews)
#   --sandbox <mode>         read-only | workspace-write | danger-full-access
#                            (default: workspace-write; --readonly forces read-only)
#   --output json|text       Output format (default: json)
#   --prompt-file <path>     Read the prompt from a file (AUTHORITATIVE — overrides
#                            the positional prompt). Non-empty file required.
#   -h, --help               Show this help
#
# Examples:
#   codex-headless-exec --repo app --tier terra --readonly -- "Audit src/lib/license.ts for Ed25519 verify bugs"
#   codex-headless-exec --repo www --tier sol --effort xhigh -- "Fix the intermittent billing race"
#
# Prerequisites:
#   - codex CLI on PATH, already authenticated (CODEX_HOME/auth.json) — Codex
#     Plus/Pro login or OPENAI_API_KEY. No env key is injected here; codex uses
#     its own stored auth.
# ============================================================================

set -euo pipefail

# ── Resolve plugin assets ───────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/plugin-root.sh
source "$SCRIPT_DIR/lib/plugin-root.sh"
PLUGIN_ROOT="$(_md_plugin_root)"

# ── Defaults ────────────────────────────────────────────────────────────
REPO=""
MODEL="gpt-5.6-terra"
MODEL_EXPLICIT=false
TIER="terra"
EFFORT="medium"
EFFORT_EXPLICIT=false
TIMEOUT="7200000"         # 120 min — codex runs long-horizon review/gap-scans; never cap a deep audit at 10 min
SANDBOX="workspace-write"
READONLY=false
OUTPUT_FORMAT="json"
PROMPT=""
PROMPT_INPUT_FILE=""
OUTPUT_FILE=""
RESULT_SCHEMA="$PLUGIN_ROOT/schemas/codex-worker-result.schema.json"

# ── Help ────────────────────────────────────────────────────────────────
show_help() {
    sed -n '2,40p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    exit 0
}

# ── Parse args ──────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
    case "$1" in
        --repo)     REPO="$2"; shift 2 ;;
        --model)    MODEL="$2"; MODEL_EXPLICIT=true; shift 2 ;;
        --tier)     TIER="$2"; shift 2 ;;
        --effort)   EFFORT="$2"; EFFORT_EXPLICIT=true; shift 2 ;;
        --timeout)  TIMEOUT="$2"; shift 2 ;;
        --sandbox)  SANDBOX="$2"; shift 2 ;;
        --readonly) READONLY=true; shift ;;
        --output)   OUTPUT_FORMAT="$2"; shift 2 ;;
        --output-file) OUTPUT_FILE="$2"; shift 2 ;;
        --prompt-file) PROMPT_INPUT_FILE="$2"; shift 2 ;;
        --skill)    SKILL_NAME="$2"; shift 2 ;;
        --command)  COMMAND_NAME="$2"; shift 2 ;;
        --no-framework) NO_FRAMEWORK=true; shift ;;
        --framework-full) FRAMEWORK_FULL=true; shift ;;
        --multi-agent) MULTI_AGENT=true; shift ;;
        -h|--help)  show_help ;;
        --)         shift; PROMPT="$*"; break ;;
        *)          PROMPT="$*"; break ;;
    esac
done

# Prompt resolution + fail-loud validation (positional OR --prompt-file).
source "$SCRIPT_DIR/lib/read-prompt.sh"
resolve_prompt "$PROMPT_INPUT_FILE" "codex-headless-exec"

# ── --skill <name>: deterministic procedure dispatch ────────────────────────
# Codex has NO commands surface (its manifest allowlist has no `commands` key)
# and NO --skill flag: a skill is either chosen by model discretion from its
# description, or named by absolute path in the prompt. Discretion is not
# dispatch — for a worker we must know WHICH procedure ran. So resolve the
# skill to its absolute SKILL.md and instruct Codex to follow it.
#
# This reads from the SOURCE tree, so it needs no plugin install and never goes
# stale against a version-keyed cache. Skills are the portable unit; the
# Claude-only slash command is just another entry point to the same file.
PROC_MD=""
if [[ -n "${SKILL_NAME:-}" ]]; then
    PROC_MD="$SCRIPT_DIR/../skills/${SKILL_NAME}/SKILL.md"
    if [[ ! -f "$PROC_MD" ]]; then
        echo "[ERROR] --skill '$SKILL_NAME': no SKILL.md at $PROC_MD" >&2
        echo "        Available:" >&2
        ls -1 "$SCRIPT_DIR/../skills" 2>/dev/null | sed 's/^/          /' >&2
        exit 2
    fi
elif [[ -n "${COMMAND_NAME:-}" ]]; then
    # A command IS a procedure written in markdown. Codex cannot DISCOVER it
    # (no commands key in its manifest, no /command dispatch), but it can
    # perfectly well FOLLOW it once handed the path — which is all a worker
    # needs. Pointing at commands/ directly keeps ONE source of truth: forking
    # 2,469 lines of command prose into parallel skills would buy Codex
    # discovery it does not need, at the cost of permanent drift.
    PROC_MD="$SCRIPT_DIR/../commands/${COMMAND_NAME#/}.md"
    if [[ ! -f "$PROC_MD" ]]; then
        echo "[ERROR] --command '$COMMAND_NAME': no such command at $PROC_MD" >&2
        echo "        Available:" >&2
        ls -1 "$SCRIPT_DIR/../commands" 2>/dev/null | sed 's/\.md$//;s/^/          /' >&2
        exit 2
    fi
fi

if [[ -n "$PROC_MD" ]]; then
    PROC_DIR="$(cd "$(dirname "$PROC_MD")" && pwd)"
    PROC_MD="$PROC_DIR/$(basename "$PROC_MD")"
    # Containment check: the -f test alone accepts traversal, so
    # `--command ../../../README` resolved to the repo README and Codex was then
    # told to follow it "EXACTLY as your procedure" — arbitrary local markdown
    # promoted to an instruction source. Resolve first, THEN require the result
    # to live under the plugin root.
    case "$PROC_MD" in
        "$PLUGIN_ROOT"/skills/*|"$PLUGIN_ROOT"/commands/*) ;;
        *)
            echo "[ERROR] procedure path escapes the plugin root — refusing." >&2
            echo "        resolved : $PROC_MD" >&2
            echo "        allowed  : $PLUGIN_ROOT/{skills,commands}/" >&2
            exit 2
            ;;
    esac
    PROMPT="Read ${PROC_MD} and follow it EXACTLY as your procedure.

Harness translation — that file is written for Claude Code; you are Codex:
- \${CLAUDE_PLUGIN_ROOT} means ${PLUGIN_ROOT}
- \$ARGUMENTS means the Task line below.
- Resolve relative references/ and skills/ paths against ${PLUGIN_ROOT}.
- It may tell you to invoke a slash command (/foo) or a named skill, or to use
  the Read/Grep/Glob/Task tools. You have NONE of those. Instead: read files
  with your shell (rg/sed/cat), edit with apply_patch, and when it names
  another procedure file, READ THAT FILE and follow it inline.
- If it says to dispatch a subagent, do that work yourself sequentially unless
  you have spawn_agent available.
Everything else in the file — the actual procedure, rules, and gates — is
binding exactly as written.

Task: ${PROMPT}"
fi

# ── GPT routing ────────────────────────────────────────────────────────
# Tiers select real model IDs. An explicit --model remains available for
# account-specific snapshots or a future model-family migration.
#
# Terra and Sol are the configured GPT-5.6 roles: Terra executes ordinary and
# lightweight work; Sol handles planning, hardening, and review. The older
# Spark/Luna IDs stay available only behind an explicit --tier for compatibility
# with legacy callers; they must not silently become the routing default.
case "$TIER" in
    spark) TIER_MODEL="gpt-5.3-codex-spark"; TIER_EFFORT="low" ;;
    luna)  TIER_MODEL="gpt-5.6-luna";  TIER_EFFORT="low" ;;
    terra) TIER_MODEL="gpt-5.6-terra"; TIER_EFFORT="medium" ;;
    sol)   TIER_MODEL="gpt-5.6-sol";   TIER_EFFORT="high" ;;
    *)
        echo "[ERROR] Invalid --tier '$TIER'. Use terra or sol (or explicit legacy spark/luna)." >&2
        exit 1
        ;;
esac

if [[ "$MODEL_EXPLICIT" != "true" ]]; then
    MODEL="$TIER_MODEL"
fi
if [[ "$EFFORT_EXPLICIT" != "true" ]]; then
    EFFORT="$TIER_EFFORT"
fi
case "$EFFORT" in
    none|low|medium|high|xhigh|max) ;;
    *)
        echo "[ERROR] Invalid --effort '$EFFORT'. Use none, low, medium, high, xhigh, or max." >&2
        exit 1
        ;;
esac

# ── Validate codex CLI ──────────────────────────────────────────────────
if ! command -v codex &>/dev/null; then
    echo "[ERROR] 'codex' CLI not found on PATH." >&2
    echo "        Install + authenticate Codex CLI first: https://developers.openai.com/codex/cli" >&2
    exit 1
fi
CODEX_CONFIG_DIR="${CODEX_HOME:-${XDG_CONFIG_HOME:+$XDG_CONFIG_HOME/codex}}"
[ -n "$CODEX_CONFIG_DIR" ] || CODEX_CONFIG_DIR="$HOME/.codex"
[ -f "$CODEX_CONFIG_DIR/auth.json" ] || { echo "[codex] auth.json missing from CODEX_HOME — run codex login or set OPENAI_API_KEY" >&2; exit 2; }

# --- repo resolution (shared, cwd-independent — see lib/resolve-workdir.sh) ---
# --repo is strict (unresolvable => abort); bare dispatch anchors to the project
# root instead of inheriting a conductor's stray `cd`.
source "$SCRIPT_DIR/lib/resolve-workdir.sh"
resolve_workdir

# ── Readonly override ───────────────────────────────────────────────────
if [[ "$READONLY" == "true" ]]; then
    SANDBOX="read-only"
fi

# ── Make .git writable so a Codex worker can honor COMMIT-ON-RED ─────────
# Codex `workspace-write` grants [workdir, /tmp, $TMPDIR] but EXCLUDES the
# repo's .git directory — deliberate upstream policy so an agent cannot rewrite
# history. Verified empirically 2026-07-20 (`test -w .git` → READONLY inside the
# sandbox; WRITABLE once .git is passed as an explicit writable root; a full
# edit→add→commit round-trip then succeeds).
#
# That exclusion collides head-on with the harness law that EVERY worker commits
# its own scoped edits before returning. Left unfixed it produces exactly one
# failure mode, and we paid for it: a worker's mandated commit dies on
# `Unable to create '.git/index.lock': Read-only file system`, so its edits sit
# uncommitted and unowned on a 4-20 agent tree until a peer's broad `git add`
# adopts them (twice, 2026-07-20).
#
# The wrong fix — the one we shipped first — was to tell Codex workers "run NO
# git command, the conductor commits." That is a per-backend exemption written
# into a task brief; it escaped its scope within a day and landed on Claude
# workers that were perfectly able to commit. Durability is not negotiable per
# backend, so the constraint is repaired HERE, in the executor that owns it,
# and never restated in prose a conductor has to remember.
#
# Anchored to the already-resolved WORK_DIR via `git -C` (never a cwd guess);
# `--absolute-git-dir` resolves worktrees and submodules, where .git is a file.
# read-only dispatches are audits that must not write at all, so they opt out.
CODEX_SANDBOX_CFG=()
if [[ "$SANDBOX" != "read-only" ]]; then
    _GIT_DIR="$(git -C "$WORK_DIR" rev-parse --absolute-git-dir 2>/dev/null || true)"
    if [[ -n "$_GIT_DIR" && -d "$_GIT_DIR" ]]; then
        CODEX_SANDBOX_CFG=(-c "sandbox_workspace_write.writable_roots=[\"$_GIT_DIR\"]")
        echo "[codex-headless-exec] .git writable (COMMIT-ON-RED enabled): $_GIT_DIR"
    else
        # No git dir => the worker cannot commit, and silence here is how an
        # exemption gets improvised downstream. Say it out loud instead.
        echo "[codex-headless-exec] WARNING: no git dir under $WORK_DIR — worker cannot commit; conductor must own durability for this dispatch." >&2
    fi
fi

# ── Resolve output ──────────────────────────────────────────────────────
if [[ -z "$OUTPUT_FILE" ]]; then
    TIMESTAMP=$(date +%Y%m%d-%H%M%S)
    OUTPUT_FILE="/tmp/claude-headless-codex-${TIMESTAMP}-$$.json"
fi
RAW_FILE="${OUTPUT_FILE}.raw"
STDERR_FILE="${OUTPUT_FILE}.stderr"
LASTMSG_FILE="${OUTPUT_FILE}.lastmsg"

# Convert ms → whole seconds for the `timeout` coreutil (min 1s).
TIMEOUT_S=$(( TIMEOUT / 1000 ))
[[ "$TIMEOUT_S" -lt 1 ]] && TIMEOUT_S=1

# ── Dashboard ───────────────────────────────────────────────────────────
cat <<EOF

╔══════════════════════════════════════════════════════════════════════════╗
║  HEADLESS EXECUTION — Codex (OpenAI)
╠══════════════════════════════════════════════════════════════════════════╣
║  Backend   : Codex
║  Model     : ${MODEL}
║  Tier      : ${TIER}
║  Effort    : ${EFFORT}
║  Repo      : ${REPO}
║  Resolved  : ${WORKDIR_ORIGIN}
║  Work Dir  : ${WORK_DIR}
║  Sandbox   : ${SANDBOX}
║  Timeout   : ${TIMEOUT}ms (${TIMEOUT_S}s)
║  Output    : ${OUTPUT_FILE}
╠══════════════════════════════════════════════════════════════════════════╣
║  Task:
║    ${PROMPT:0:70}...
╚══════════════════════════════════════════════════════════════════════════╝

EOF

echo "[codex-headless-exec] Starting headless Codex..."
echo "[codex-headless-exec] Working directory: $WORK_DIR"
echo "[codex-headless-exec] Output file: $OUTPUT_FILE"
echo ""

# ── Execute ─────────────────────────────────────────────────────────────
# Prompt is piped via stdin (codex reads it when the positional arg is `-`),
# which is robust against prompts that begin with a dash.
# --json     → JSONL event stream to stdout (→ RAW_FILE)
# -o FILE    → final agent message (→ LASTMSG_FILE, the canonical result)
# -s MODE    → sandbox policy (read-only for audits, workspace-write for fixes)
cd "$WORK_DIR"

# ── Git-discipline preamble (defense in depth for lifecycle hooks) ────────────
# Codex supports lifecycle hooks. A trusted installed meta-dev plugin loads the
# Codex adapter in hooks/hooks.json, which bridges guard policy to Codex tool
# events. This runner deliberately never uses --dangerously-bypass-hook-trust:
# trust the installed plugin through Codex's normal trust flow instead.
#
# The prompt repeats the git rules because a direct headless invocation can run
# before plugin hooks are installed/trusted, and `--sandbox workspace-write`
# does not itself stop a broad git add. Hooks enforce policy where available;
# prompt rules remain the portable second line of defense.
# ── Framework preamble: the harness a Codex worker is otherwise blind to ────
# A Claude Code worker is BORN inside the harness — plugin skills and slash
# commands are present, hooks fire, CLAUDE.md is in context. A Codex worker does
# not inherit Claude's command surface or CLAUDE.md; trusted Codex lifecycle
# hooks may still fire, but a bare headless task must receive its procedure.
# Interactive Codex has @meta-dev and $meta-dev:<skill>; HEADLESS has neither.
# So we hand it the framework in the one channel headless does have — the
# prompt. Roster is generated from disk, so it cannot drift from reality.
# --no-framework opts out for trivial one-shots (a codeword probe, a lookup).
if [[ "${NO_FRAMEWORK:-false}" != "true" ]]; then
    FRAMEWORK_PREAMBLE="$(python3 "$SCRIPT_DIR/lib/framework-preamble.py" \
        "$PLUGIN_ROOT" ${FRAMEWORK_FULL:+--full} 2>/dev/null || true)"
    if [[ -n "$FRAMEWORK_PREAMBLE" ]]; then
        PROMPT="${FRAMEWORK_PREAMBLE}

${PROMPT}"
    fi
fi

# ── Delegation preamble: how a worker buys cheap capacity ───────────────────
# Two DIFFERENT mechanisms, and conflating them costs money:
#
# Codex native delegation can select a model. Keep ordinary execution on Terra;
# pin Sol only for judgment-heavy planning, hardening, or review. Explicit
# legacy/external dispatch choices remain caller-controlled rather than inferred.
DELEGATION_PREAMBLE="DELEGATING SUB-WORK (current Codex roles):
Native Codex delegation may select its model. Use gpt-5.6-terra for bounded
execution and lightweight work; reserve gpt-5.6-sol for planning, hardening,
or review that needs deeper judgment. For a direct child process, pin the role:

  codex exec -m gpt-5.6-terra --sandbox read-only \\
    -c model_reasoning_effort=low '<bounded sub-task with acceptance criteria>'

Give each delegated sub-task explicit scope and success criteria, then VERIFY
its output yourself — you remain accountable for the result. Do not replace an
explicit legacy or external backend flag selected by the conductor.
"
if [[ "${MULTI_AGENT:-false}" == "true" ]]; then
    DELEGATION_PREAMBLE="${DELEGATION_PREAMBLE}
You also have spawn_agent (up to 4 concurrent, including you). Use its model
selection when the host exposes it; otherwise use direct codex exec with -m.
Use parallelism only for genuinely independent work.
"
fi
PROMPT="${DELEGATION_PREAMBLE}
${PROMPT}"

WORK_DISCIPLINE_PREAMBLE='WORK DISCIPLINE (binding — a Codex run is slow mostly from RE-READING, not from testing):
1. READ WIDE, ONCE. The first time you open a file, read it WHOLE (`nl -ba <path>` or `cat <path>`) — never a narrow `sed -n A,Bp` window you will have to re-open. A short peek falls out of context and you fetch it again; that re-fetch is the single biggest cost of a Codex run (measured: ~half of all reads re-open a file already read this run; plan/spec files are the worst).
2. DO NOT RE-READ TO REMEMBER. Once a file is read, its content is in your context — re-scan your own context, do not re-open the file. Re-open ONLY to see a change you just made or one another agent just made. Read a task/plan section once, keep it, act on it.
3. FOCUSED VERIFICATION ONLY. Run one named test file/node: `pytest path/to/test_x.py -q` (add `-m "not slow and not gpu and not integration"` if marked). NEVER bare/directory pytest, `pytest -k` without a file, package-wide npm/Vitest/Jest, `npm run check`, `svelte-check`, project-wide `tsc`, a build, or a full suite — not per task and not at phase end. Those belong to CI/ship or a separate explicit user request. One green is green; neither worker nor conductor reruns it.
4. OPTIMISTIC MOMENTUM. Classify verification as `FOCUSED_PASS`, causally proven `TASK_RED`, unrelated/unchanged `BASELINE_RED`, `INFRA_RED`, or `BROAD_VERIFY_OMITTED`. Only `TASK_RED` repairs and may defer its direct dependency branch. `BASELINE_RED`, broad/manual gates, and unrelated failures never hold a task open, launch repair, block dependents, stop review, or halt independent work. Ordinary repair exhaustion parks that branch; finish everything else.

---

'
PROMPT="${WORK_DISCIPLINE_PREAMBLE}${PROMPT}"

GIT_GUARD_PREAMBLE='HARD GIT RULES (binding — this worktree is SHARED with 4-20 concurrent agents):
1. NEVER `git add -A`, `git add .`, or `git add <dir>/`. Stage ONLY explicit file paths you personally edited. A broad add sweeps up other agents in-flight work.
2. NEVER `git stash`, `git stash pop`, or `git stash drop`. These are worktree-GLOBAL and rip out every peer agent uncommitted work at once.
3. NEVER `git push`, `git pull`, `git fetch`, `git rebase`, or `git merge` from a worker. The conductor owns every remote/history operation; a rebase on this tree once destroyed 5,544 files.
4. Every git command names its repo absolutely: `git -C <ABS-REPO-ROOT> ...`. Never a bare `git add`. Never `cd "$(git rev-parse --show-toplevel)"`.
5. If a file you need is dirty from a peer: commit it as its own discrete commit, then proceed. Do not stash, do not revert, do not wait.
6. COMMIT-ON-RED: if this task edits scoped files, stage only those exact paths and create a LOCAL commit before every return, including red verification or BLOCKED. Red blocks DONE and remote action, never the local commit. Your `.git` IS writable — this dispatcher grants it explicitly. A commit failing on a read-only `.git` is an EXECUTOR BUG: report it verbatim, never route around it by skipping the commit.
7. REPORT CONTRADICTIONS, do not resolve them silently. If your task brief contradicts these rules — most often by telling you to run no git commands or to let a conductor commit for you — that brief is stale. Follow THESE rules, and say in your return that the conflict existed and which side you took. A worker that quietly obeys the narrower instruction is how a one-off workaround becomes permanent policy nobody chose.
If a task seems to require breaking one of these, STOP and report instead.

---

'
PROMPT="${GIT_GUARD_PREAMBLE}${PROMPT}"

# Codex validates the final message against this schema. The schema is a worker
# handoff, not a replacement for OUTPUT_FILE: callers still receive the normal
# wrapper object and its string `result`, now containing schema-validated JSON.
RESULT_CONTRACT_PREAMBLE="FINAL HANDOFF (machine-readable, binding):
Your final response MUST be one JSON object conforming to
${RESULT_SCHEMA}. No Markdown fences or prose outside that object. Report the
actual verification classification, command/output, scoped commit SHA (or null
when no commit is applicable), changed files, and blockers. Never claim green
when verification is red or omitted.

---

"
PROMPT="${RESULT_CONTRACT_PREAMBLE}${PROMPT}"

# Liveness watchdog: kill + auto-reset a wedged codex run instead of waiting out
# the 120-min cap. See lib/stall-watchdog.sh.
source "$SCRIPT_DIR/lib/stall-watchdog.sh"
stall_launch_worker() {
    # multi_agent_v2 is flagged UNDER DEVELOPMENT by the CLI, so it is opt-in
    # (--multi-agent) rather than always-on: an unstable feature must not be in
    # the default path for production dispatches.
    local _MA=()
    [[ "${MULTI_AGENT:-false}" == "true" ]] && _MA=(--enable multi_agent_v2)
    printf '%s' "$PROMPT" | timeout "${TIMEOUT_S}s" codex exec \
        --json \
        --output-schema "$RESULT_SCHEMA" \
        -o "$LASTMSG_FILE" \
        -s "$SANDBOX" \
        "${CODEX_SANDBOX_CFG[@]}" \
        --skip-git-repo-check \
        "${_MA[@]}" \
        -m "$MODEL" \
        -c "model_reasoning_effort=\"$EFFORT\"" \
        - \
        > "$RAW_FILE" 2> "$STDERR_FILE" &
    WORKER_PID=$!
}

# Portable ms epoch. BSD `date` lacks %N and mis-succeeds (prints literal "N"),
# so prefer GNU date (gdate on macOS+coreutils, plain date on Linux), then
# validate the result is pure digits — any junk falls back to python3.
_now_ms() {
  local t
  if command -v gdate >/dev/null 2>&1; then t=$(gdate +%s%3N 2>/dev/null)
  else t=$(date +%s%3N 2>/dev/null); fi
  case "$t" in
    ''|*[!0-9]*) t=$(python3 -c 'import time;print(int(time.time()*1000))' 2>/dev/null || echo "$(( $(date +%s) * 1000 ))") ;;
  esac
  printf '%s' "$t"
}
START_TIME=$(_now_ms)
run_with_stall_watchdog
EXIT_CODE=$STALL_EXIT

END_TIME=$(_now_ms)
ELAPSED_MS=$(( END_TIME - START_TIME ))
ELAPSED_S=$(( ELAPSED_MS / 1000 ))

# timeout(1) exits 124 when it kills the child — surface as an error.
if [[ $EXIT_CODE -eq 124 ]]; then
    echo "[WARN] codex exec timed out after ${TIMEOUT_S}s." >> "$STDERR_FILE"
fi

# ── Validate structured final handoff, then distill event metadata ───────
# --output-schema asks Codex to produce the worker handoff directly. Validate
# the saved last message again so an old CLI or a broken stub cannot silently
# turn malformed text into an apparently successful OUTPUT_FILE contract.
validate_worker_result() {
    python3 - "$RESULT_SCHEMA" "$LASTMSG_FILE" <<'PY'
import json
import sys

schema_path, result_path = sys.argv[1:3]
try:
    schema = json.load(open(schema_path, encoding="utf-8"))
    result = json.load(open(result_path, encoding="utf-8"))
except (OSError, json.JSONDecodeError) as exc:
    raise SystemExit(f"not valid JSON: {exc}")

required = schema.get("required", [])
properties = schema.get("properties", {})
if not isinstance(result, dict):
    raise SystemExit("final response must be a JSON object")
unexpected = set(result) - set(properties)
missing = [key for key in required if key not in result]
if unexpected:
    raise SystemExit("unexpected field(s): " + ", ".join(sorted(unexpected)))
if missing:
    raise SystemExit("missing required field(s): " + ", ".join(missing))
if result.get("verification") not in properties["verification"]["enum"]:
    raise SystemExit("verification is not a supported classification")
for field in ("summary", "verify_command", "verify_output"):
    if not isinstance(result.get(field), str):
        raise SystemExit(f"{field} must be a string")
if not result["summary"]:
    raise SystemExit("summary must not be empty")
if result.get("commit_sha") is not None and not isinstance(result.get("commit_sha"), str):
    raise SystemExit("commit_sha must be a string or null")
for field in ("changed_files", "blockers"):
    if not isinstance(result.get(field), list) or not all(isinstance(v, str) and v for v in result[field]):
        raise SystemExit(f"{field} must be an array of strings")
PY
}

if ! RESULT_VALIDATION_ERROR="$(validate_worker_result 2>&1)"; then
    echo "[ERROR] malformed structured Codex result: $RESULT_VALIDATION_ERROR" >> "$STDERR_FILE"
    # Preserve the wrapper contract, but make malformed worker output fatal.
    [[ $EXIT_CODE -eq 0 ]] && EXIT_CODE=3
fi

# ── Distill event metadata → existing clean OUTPUT_FILE contract ─────────
RESULT_TEXT=""
IS_ERROR="unknown"
PARSE_OK=false
if [[ "$OUTPUT_FORMAT" == "json" ]]; then
    if RESULT_TEXT=$(python3 "$SCRIPT_DIR/lib/distill-codex-result.py" \
            "$RAW_FILE" "$LASTMSG_FILE" "$OUTPUT_FILE" "$EXIT_CODE" "$ELAPSED_MS" \
            2>>"$STDERR_FILE"); then
        PARSE_OK=true
        IS_ERROR=$(python3 -c "import json,sys; print(json.load(open(sys.argv[1])).get('is_error'))" "$OUTPUT_FILE" 2>/dev/null || echo unknown)
    fi
fi
if [[ "$PARSE_OK" != "true" ]]; then
    cp "$RAW_FILE" "$OUTPUT_FILE"
    if [[ "$OUTPUT_FORMAT" == "json" ]]; then
        RESULT_TEXT="[distill failed — inspect raw payload: $RAW_FILE / stderr: $STDERR_FILE]"
        [[ $EXIT_CODE -eq 0 ]] && EXIT_CODE=3
    else
        RESULT_TEXT="$(cat "$LASTMSG_FILE" 2>/dev/null || cat "$RAW_FILE")"
    fi
fi

# A run that reported is_error:true should not look like success.
if [[ "$IS_ERROR" == "True" && $EXIT_CODE -eq 0 ]]; then
    EXIT_CODE=4
fi

# Stall-halt: codex went silent through the whole reset budget — surface loudly
# (distinct exit 125) so the conductor PAUSES rather than trusting the silence.
if [[ "${STALL_HALTED:-false}" == "true" ]]; then
    IS_ERROR="True"
    RESULT_TEXT="[STALLED — codex produced no output for $(( ${STALL_SECS:-300} / 60 ))m, killed and re-dispatched ${STALL_RESETS}× then HALTED. Run PAUSED for review. Partial trace: $RAW_FILE]"
fi

# ── Result summary ──────────────────────────────────────────────────────
echo ""
echo "────────────────────────────────────────────────────────────────────────"
echo "  HEADLESS EXECUTION COMPLETE"
echo "────────────────────────────────────────────────────────────────────────"
echo "  Backend   : Codex ($MODEL, $TIER, effort=$EFFORT)"
echo "  Exit code : $EXIT_CODE"
echo "  is_error  : $IS_ERROR"
echo "  Elapsed   : ${ELAPSED_S}s"
[[ "${STALL_RESETS:-0}" -gt 0 ]] && echo "  Stalls    : ${STALL_RESETS} auto-reset(s)$([[ "${STALL_HALTED:-false}" == "true" ]] && echo " → HALTED (paused for review)")"
echo "  Result    : $OUTPUT_FILE   (clean JSON — result/is_error/turns)"
echo "  Raw trace : $RAW_FILE"
echo "  Stderr    : $STDERR_FILE"
echo "────────────────────────────────────────────────────────────────────────"

if [[ $EXIT_CODE -ne 0 ]]; then
    echo ""
    echo "[WARN] Headless execution exit code $EXIT_CODE (is_error=$IS_ERROR)."
    echo "       Inspect: $STDERR_FILE"
fi

# ── Surface the distilled result text for the orchestrator ──────────────
echo ""
echo "════════════════════════ RESULT ════════════════════════════════════════"
printf '%s\n' "$RESULT_TEXT"
echo "═════════════════════════════════════════════════════════════════════════"
echo "OUTPUT_FILE=$OUTPUT_FILE"

exit $EXIT_CODE
