#!/usr/bin/env bash
# ============================================================================
# claude-headless-exec — Execute a task via headless Claude Code on a
#                        specified backend (deepseek, glm, sonnet, opus, fable).
#
# Usage:
#   claude-headless-exec --backend deep|glm|sonnet|opus|fable [options] -- <prompt>
#
# Options:
#   --backend deep|glm      Required. Backend to use.
#   --repo <name>            Resolve via topology config; unresolvable => abort.
#                            Omit to run at the PROJECT ROOT (never the caller's cwd).
#   --model <model>          Override default model for this backend
#   --tier <flash|pro>       DeepSeek-only convenience: map to deepseek-v4-flash|pro
#                            (ignored on other backends; --model wins over --tier)
#   --flash / --pro          DeepSeek-only boolean sugars for --tier flash|pro
#                            (default is Pro; --flash is the mechanical downgrade)
#   --timeout <ms>           Timeout in ms (default: 7200000 = 120 min)
#   --tools <list>           Comma-separated tool list (default: Read,Write,Edit,Bash,Grep,Glob)
#   --readonly               Restrict to read-only tools (Read,Bash,Grep)
#   --output json|text       Output format (default: json)
#   --max-turns <n>          Max agent turns for the headless worker (default: unset)
#   -h, --help               Show this help
#
# Examples:
#   claude-headless-exec --backend deep --repo app -- "Fix all TypeScript errors"
#   claude-headless-exec --backend glm --repo www --readonly -- "Audit for SQL injection"
#   claude-headless-exec --backend deep -- "Hard multi-step agentic refactor"
#   claude-headless-exec --backend deep --flash -- "Rename getCwd across the project"
#
# Backend defaults:
#   deep   → deepseek-v4-pro (default primary / opus slot; V4-Pro-0813 GA on this ID)
#            deepseek-v4-flash for --flash / haiku / nested subagents
#            Flash-0731 is the mechanical bulk downgrade — cheaper + faster + 1M ctx.
#   glm    → glm-5.2 (opus/sonnet/subagent), glm-4.5 (haiku) — routed via local beta-strip proxy
#   sonnet → claude-sonnet-5; REAL Anthropic via ambient login (1M context)
#   opus   → claude-opus-5;   REAL Anthropic via ambient login (1M context)
#   fable  → claude-fable-5;  REAL Anthropic via ambient login (1M) — top-tier reasoning
#
# On the FIRST-PARTY Anthropic API the 5-family is 1M by default: there is no
# 200K variant and no [1m] suffix to select. Verified 2026-07-25 — bare and
# [1m] forms both report contextWindow=1000000, and Claude Code's docs state
# "Sonnet 5 always runs with the 1M context window ... no [1m] suffix to
# select". 1M bills at standard rates with no premium above 200K, so DON'T add
# [1m] here — it is a no-op. It matters only on Bedrock / Google Cloud /
# Microsoft Foundry, where a model ID without it falls back to 200K.
#
# Prerequisites:
#   - DEEPSEEK_API_KEY env var (for --backend deep)
#   - GLM_API_KEY env var (for --backend glm)
#   - --backend sonnet|opus|fable needs NO key — it uses your ambient Claude login
#   - claude CLI on PATH
# ============================================================================

set -euo pipefail

# ── Resolve plugin assets ───────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/plugin-root.sh
source "$SCRIPT_DIR/lib/plugin-root.sh"
PLUGIN_ROOT="$(_md_plugin_root)"

# ── Backend defaults ────────────────────────────────────────────────────
declare -A BACKEND_BASE_URL
declare -A BACKEND_AUTH_KEY_ENV
declare -A BACKEND_OPUS_MODEL
declare -A BACKEND_SONNET_MODEL
declare -A BACKEND_HAIKU_MODEL
declare -A BACKEND_SUBAGENT_MODEL
declare -A BACKEND_EFFORT
declare -A BACKEND_LABEL

BACKEND_BASE_URL[deep]="https://api.deepseek.com/anthropic"
BACKEND_AUTH_KEY_ENV[deep]="DEEPSEEK_API_KEY"
# DeepSeek V4 pair (both 1M context). Default primary is Pro (V4-Pro-0813 GA
# served on the stable ID deepseek-v4-pro as of 2026-08-13). Flash-0731 is the
# --flash / haiku / nested-subagent slot — 284B/13B active, ~3× cheaper.
BACKEND_OPUS_MODEL[deep]="deepseek-v4-pro"            # hard sub-work (same as default)
BACKEND_SONNET_MODEL[deep]="deepseek-v4-pro"          # DEFAULT primary worker
BACKEND_HAIKU_MODEL[deep]="deepseek-v4-flash"
BACKEND_SUBAGENT_MODEL[deep]="deepseek-v4-flash"      # nested cheap; primary stays Pro
BACKEND_EFFORT[deep]=""                               # DECIDED: no effort knob on this backend — see the resolve block, which warns rather than forwarding
BACKEND_LABEL[deep]="DeepSeek"

BACKEND_BASE_URL[glm]="https://api.z.ai/api/anthropic"   # real upstream; worker talks to the local beta-strip proxy (see GLM_PROXY block below)
BACKEND_AUTH_KEY_ENV[glm]="GLM_API_KEY"
BACKEND_OPUS_MODEL[glm]="glm-5.2"        # NO [1m]: Z.AI returns [1211] Unknown Model for "glm-5.2[1m]"; glm-5.2 is the funded standard tier (HTTP 200)
BACKEND_SONNET_MODEL[glm]="glm-5.2"
BACKEND_HAIKU_MODEL[glm]="glm-4.5"       # glm-4.7-flashx needs a prepaid pkg (empty -> [1113]); glm-4.5 is the funded fallback. Revert to flashx after recharging Z.AI.
BACKEND_SUBAGENT_MODEL[glm]="glm-5.2"
BACKEND_EFFORT[glm]="high"                            # DECIDED high: unpooled/explicit-only backend, reached deliberately for stateful work — no reason to under-think it
BACKEND_LABEL[glm]="GLM"

# sonnet → REAL Anthropic backend via your ambient Claude login (NOT a 3rd
# party). No base URL, no API key — just pin the Sonnet model. What this buys is
# CONTEXT ECONOMY: the worker's reads and tool churn stay in its own window and
# only a distilled result returns, so the conductor's context is preserved.
# It does NOT buy a smaller billed window — see the 1M note in the header.
BACKEND_BASE_URL[sonnet]=""                          # ambient — no override
BACKEND_AUTH_KEY_ENV[sonnet]=""                      # ambient login — no key
BACKEND_OPUS_MODEL[sonnet]="claude-sonnet-5"         # n/a (sonnet backend never runs opus)
BACKEND_SONNET_MODEL[sonnet]="claude-sonnet-5"       # Sonnet 5 (1M on first-party; no suffix needed)
BACKEND_HAIKU_MODEL[sonnet]="claude-haiku-4-5-20251001"
BACKEND_SUBAGENT_MODEL[sonnet]="claude-sonnet-5"     # its own subagents stay on Sonnet 5 too
BACKEND_EFFORT[sonnet]="high"                        # DECIDED high: Anthropic's own API default, and the quality/token sweet spot for a bulk per-task code writer under a cap. xhigh is Anthropic's pick for the HARDEST coding/agentic work — reach for it per-task via --effort, not as the fleet default. Sweep down to medium/low on mechanical batches.
BACKEND_LABEL[sonnet]="Sonnet-5"

# opus → REAL Anthropic backend via the ambient Claude login (same shape as
# sonnet, one tier up). Pin claude-opus-5. Reach for it when a task needs
# top-tier Anthropic reasoning off the main thread — the win is context hygiene
# (the conductor's window stays lean), not a smaller billed window.
BACKEND_BASE_URL[opus]=""                            # ambient — no override
BACKEND_AUTH_KEY_ENV[opus]=""                        # ambient login — no key
BACKEND_OPUS_MODEL[opus]="claude-opus-5"             # Opus 5 (1M on first-party; no suffix needed)
BACKEND_SONNET_MODEL[opus]="claude-opus-5"           # primary/default slot (read at model resolution)
BACKEND_HAIKU_MODEL[opus]="claude-haiku-4-5-20251001"
BACKEND_SUBAGENT_MODEL[opus]="claude-opus-5"         # its own subagents stay on Opus 5 too
BACKEND_EFFORT[opus]="high"                          # DECIDED high: same reasoning as sonnet, and Opus is already the expensive tier — --effort xhigh for a genuinely hard one-off, medium/low to conserve the Opus cap
BACKEND_LABEL[opus]="Opus-5"

# fable → REAL Anthropic backend via the ambient Claude login. Pin
# claude-fable-5. Fable 5 is the top of the ambient ladder — reach
# for it on the HARDEST, most-complex tasks that demand extreme reasoning and
# long-horizon coherence, off the main thread.
BACKEND_BASE_URL[fable]=""                           # ambient — no override
BACKEND_AUTH_KEY_ENV[fable]=""                       # ambient login — no key
BACKEND_OPUS_MODEL[fable]="claude-fable-5"           # n/a slot — Fable everywhere
BACKEND_SONNET_MODEL[fable]="claude-fable-5"         # primary/default slot (read at model resolution)
BACKEND_HAIKU_MODEL[fable]="claude-haiku-4-5-20251001"
BACKEND_SUBAGENT_MODEL[fable]="claude-fable-5"       # its own subagents stay Fable too
BACKEND_EFFORT[fable]="high"                          # DECIDED high: Fable thinks hard intrinsically (thinking is always on and cannot be disabled), so high is already deep — raise to xhigh/max only for the brutal ones
BACKEND_LABEL[fable]="Fable-5"

# ── Defaults ────────────────────────────────────────────────────────────
BACKEND=""
REPO=""
MODEL=""
TIER=""      # deep-only convenience: flash|pro → deepseek-v4-flash|pro (--model wins)
FLASH_FLAG=0 # 1 when --flash was passed (sugar for --tier flash)
PRO_FLAG=0   # 1 when --pro was passed (sugar for --tier pro)
MODEL_EXPLICIT=0  # 1 when --model was passed (so --tier cannot override it)
EFFORT=""    # thinking/reasoning effort; resolved from per-backend default unless --effort given
EFFORT_EXPLICIT=0   # 1 when the caller passed --effort (so a no-knob backend can warn instead of silently dropping it)
TIMEOUT=""   # resolved after parse (all backends → 7200000 = 120 min) unless --timeout given
TOOLS="Read,Write,Edit,Bash,Grep,Glob"
OUTPUT_FORMAT="stream-json"   # streams events → RAW file GROWS incrementally so the
                              # stall-watchdog can tell a hang from a healthy long run.
                              # (buffered `json` writes nothing until the end → any run
                              #  longer than STALL_SECS false-stalls. See liveness block.)
READONLY=false
MAX_BUDGET_USD=""
MAX_TURNS=""
PROMPT=""
PROMPT_INPUT_FILE=""
OUTPUT_FILE=""
CLAIM_SCOPE=""   # --claim <dir>: claim this plan-dir scope in the cross-session
                 # registry before dispatching; auto-released on exit (concurrency safety)
CLAIM_WARN=false # --claim-warn: on an overlapping live claim, WARN and proceed
                 # instead of the default ABORT (do-not-dispatch)

# ── Help ────────────────────────────────────────────────────────────────
show_help() {
    cat <<'EOF'
╔══════════════════════════════════════════════════════════════════════════╗
║                    claude-headless-exec                                 ║
║     Spawn a headless Claude Code worker on a chosen AI backend          ║
╚══════════════════════════════════════════════════════════════════════════╝

Usage:
  claude-headless-exec --backend deep|glm|sonnet|opus|fable [options] -- <prompt>

Required:
  --backend <name>           Backend to execute on:
                             deep | glm | sonnet | opus | fable
                             (sonnet/opus/fable = real Anthropic, ambient login)

Options:
  --repo <name>             Resolve via .claude/meta-dev-repos.json; an
                            unknown name ABORTS. Omit => project root (not cwd).
  --model <model>           Override the default model
  --tier <flash|pro>        DeepSeek-only: deepseek-v4-flash | deepseek-v4-pro
                            (ignored on other backends; --model wins over --tier)
  --flash                   DeepSeek-only: force deepseek-v4-flash (mechanical)
  --pro                     DeepSeek-only: force deepseek-v4-pro (already default)
  --effort <level>          Thinking effort: low|medium|high|xhigh|max
                            (per-backend default: sonnet/opus/fable=high, glm=high, deep=none)
  --timeout <ms>            Timeout in ms via API_TIMEOUT_MS (default: 7200000 = 120 min)

Liveness watchdog (env knobs — a wedged worker that goes silent is killed and
auto-reset, instead of idling out the full 120-min cap):
  STALL_SECS=<s>            No RAW-output growth this long → stuck; kill +
                            auto-reset (default 300 = 5 min; 0 disables)
  STALL_MAX_RESETS=<n>      Auto-resets before halt-and-pause (default 3); on
                            exhaustion the run STOPS with exit 125 for review
  STALL_POLL_SECS=<s>       Output-size poll interval (default 30)
  --tools <list>            Comma-separated tools (default: Read,Write,Edit,Bash,Grep,Glob)
  --readonly                Restrict to Read,Bash,Grep only
  --claim <dir>             Claim this plan-dir scope in the cross-session
                            registry before dispatch; auto-released on exit.
                            ABORTS (no dispatch) if another live session holds
                            an overlapping scope — the concurrency-safety gate.
  --claim-warn              On an overlapping live claim, warn + proceed
                            instead of aborting.
  --output json|text        Output format (default: json)
  --max-budget-usd <n>      Max API spend in USD (default: unlimited)
  --max-turns <n>           Max agent turns for the headless worker (default: unset)
  --output-file <path>      Write result to file instead of stdout
  -h, --help                Show this help

Backend defaults (model · effort):
  deep   → deepseek-v4-pro          (DeepSeek API · V4-Pro-0813 · effort n/a)
           --flash / --tier flash → deepseek-v4-flash (mechanical bulk)
  glm    → glm-5.2                    (Z.AI API · effort high · via local beta-strip proxy)
  sonnet → claude-sonnet-5          (Anthropic · ambient login · effort high)
  opus   → claude-opus-5            (Anthropic · ambient login · effort high)
  fable  → claude-fable-5           (Anthropic · ambient login · effort high · hardest tasks)

Examples:
  claude-headless-exec --backend deep --repo app -- "Fix all TS errors"
  claude-headless-exec --backend deep --flash -- "Rename getCwd across the project"
  claude-headless-exec --backend deep --tier pro -- "Hard multi-step agentic refactor"
  claude-headless-exec --backend glm --repo www --readonly -- "Audit auth"
  claude-headless-exec --backend sonnet --repo app -- "Review the diff"
  claude-headless-exec --backend opus --repo app -- "Redesign the render-node lineage"
  claude-headless-exec --backend fable --repo app -- "Untangle the hardest coherence bug"
  claude-headless-exec --backend deep --model deepseek-v4-flash -- \
    "Rename getCwd across the project"  # same as --flash

Prerequisites:
  DEEPSEEK_API_KEY env var (for --backend deep)
  GLM_API_KEY env var (for --backend glm)
  --backend sonnet|opus|fable needs NO key (uses ambient Claude login)
  claude CLI on PATH
EOF
}

# ── Parse args ──────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
    case "$1" in
        --backend)
            BACKEND="$2"
            shift 2
            ;;
        --repo)
            REPO="$2"
            shift 2
            ;;
        --model)
            MODEL="$2"
            MODEL_EXPLICIT=1
            shift 2
            ;;
        --tier)
            TIER="$2"
            shift 2
            ;;
        --flash)
            FLASH_FLAG=1
            shift
            ;;
        --pro)
            PRO_FLAG=1
            shift
            ;;
        --effort)
            EFFORT="$2"
            EFFORT_EXPLICIT=1
            shift 2
            ;;
        --timeout)
            TIMEOUT="$2"
            shift 2
            ;;
        --tools)
            TOOLS="$2"
            shift 2
            ;;
        --output)
            OUTPUT_FORMAT="$2"
            shift 2
            ;;
        --max-budget-usd)
            MAX_BUDGET_USD="$2"
            shift 2
            ;;
        --max-turns)
            MAX_TURNS="$2"
            shift 2
            ;;
        --output-file)
            OUTPUT_FILE="$2"
            shift 2
            ;;
        --readonly)
            READONLY=true
            shift
            ;;
        --claim)
            CLAIM_SCOPE="$2"
            shift 2
            ;;
        --claim-warn)
            CLAIM_WARN=true
            shift
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        --prompt-file) PROMPT_INPUT_FILE="$2"; shift 2 ;;
        --)
            shift
            PROMPT="$*"
            break
            ;;
        *)
            # Catch-all: treat as start of prompt
            PROMPT="$*"
            break
            ;;
    esac
done

# ── Validate ────────────────────────────────────────────────────────────
if [[ -z "$BACKEND" ]]; then
    echo "[ERROR] --backend is required. Use 'deep', 'glm', or 'sonnet'." >&2
    echo "        Run with --help for usage." >&2
    exit 1
fi

if [[ "$BACKEND" != "deep" && "$BACKEND" != "glm" && "$BACKEND" != "sonnet" \
      && "$BACKEND" != "opus" && "$BACKEND" != "fable" ]]; then
    echo "[ERROR] Unknown backend '$BACKEND'. Use 'deep', 'glm', 'sonnet', 'opus', or 'fable'." >&2
    exit 1
fi

# Prompt resolution + fail-loud validation (positional OR --prompt-file).
source "$SCRIPT_DIR/lib/read-prompt.sh"
resolve_prompt "$PROMPT_INPUT_FILE" "claude-headless-exec"

# --- repo resolution (shared, cwd-independent — see lib/resolve-workdir.sh) ---
# A stray `cd child-repo/` in the conductor's shell must NOT re-point workers:
# --repo is strict (unresolvable => abort), and bare dispatch anchors to the
# project root rather than inheriting $(pwd).
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/lib/resolve-workdir.sh"
resolve_workdir

if [[ ! -d "$WORK_DIR" ]]; then
    echo "[ERROR] Working directory not found: $WORK_DIR" >&2
    exit 1
fi

# ── Validate API key ────────────────────────────────────────────────────
# Backends with an empty key-env (sonnet) authenticate via the ambient
# Ambient Claude login — no API key to validate, so skip this block entirely.
AUTH_KEY_ENV="${BACKEND_AUTH_KEY_ENV[$BACKEND]}"
AUTH_KEY=""
if [[ -n "$AUTH_KEY_ENV" ]]; then
    AUTH_KEY="${!AUTH_KEY_ENV:-}"
    if [[ -z "$AUTH_KEY" ]]; then
        cat <<EOF >&2
[ERROR] $AUTH_KEY_ENV is not set.

The $AUTH_KEY_ENV environment variable is required for --backend $BACKEND.
Set it with:

  export $AUTH_KEY_ENV="your-api-key"

Then persist in ~/.bashrc:

  echo 'export $AUTH_KEY_ENV="your-api-key"' >> ~/.bashrc

EOF
        exit 1
    fi
fi

# ── Validate claude CLI ─────────────────────────────────────────────────
if ! command -v claude &>/dev/null; then
    echo "[ERROR] 'claude' CLI not found on PATH." >&2
    echo "        Install Claude Code first: https://docs.anthropic.com/en/docs/claude-code" >&2
    exit 1
fi

# ── Readonly override ───────────────────────────────────────────────────
if [[ "$READONLY" == "true" ]]; then
    TOOLS="Read,Bash,Grep"
fi

# ── Resolve model ───────────────────────────────────────────────────────
# --flash / --pro are DeepSeek-only boolean sugars for --tier. --model always
# wins when both a tier flag and --model are set.
if [[ "$FLASH_FLAG" == "1" && "$PRO_FLAG" == "1" ]]; then
    echo "[ERROR] --flash and --pro cannot be combined." >&2
    exit 1
fi
if [[ "$FLASH_FLAG" == "1" ]]; then
    if [[ -n "$TIER" && "$TIER" != "flash" ]]; then
        echo "[ERROR] --flash conflicts with --tier '$TIER'." >&2
        exit 1
    fi
    TIER="flash"
fi
if [[ "$PRO_FLAG" == "1" ]]; then
    if [[ -n "$TIER" && "$TIER" != "pro" ]]; then
        echo "[ERROR] --pro conflicts with --tier '$TIER'." >&2
        exit 1
    fi
    TIER="pro"
fi
# --tier is DeepSeek-only sugar (flash|pro). --model always wins when both set.
if [[ -n "$TIER" ]]; then
    if [[ "$BACKEND" != "deep" ]]; then
        echo "[WARN] --tier '$TIER' ignored: only applies to --backend deep (got '$BACKEND')." >&2
    elif [[ "$MODEL_EXPLICIT" == "1" ]]; then
        echo "[WARN] --tier '$TIER' ignored: --model '$MODEL' already set and wins." >&2
    else
        case "$TIER" in
            flash) MODEL="deepseek-v4-flash" ;;
            pro)   MODEL="deepseek-v4-pro" ;;
            *)
                echo "[ERROR] Invalid --tier '$TIER' for deep backend. Use: flash, pro." >&2
                exit 1
                ;;
        esac
    fi
fi
if [[ -z "$MODEL" ]]; then
    MODEL="${BACKEND_SONNET_MODEL[$BACKEND]}"
fi

# ── Resolve effort (per-backend default unless --effort given) ───────────
# Per-backend defaults live in the BACKEND_EFFORT table above — that table is the
# SINGLE definition point for effort in this harness; don't add a second one.
# A backend whose BACKEND_EFFORT is EMPTY has declared "no effort knob": we do
# NOT forward an effort level to it, and if the caller asked for one we say so
# instead of dropping it silently (the old behaviour contradicted the docs,
# which promised --effort was a no-op for deep while the script forwarded it).
if [[ -z "${BACKEND_EFFORT[$BACKEND]}" ]]; then
    if [[ "$EFFORT_EXPLICIT" == "1" ]]; then
        echo "[WARN] --effort '$EFFORT' ignored: backend '$BACKEND' has no effort knob (BACKEND_EFFORT is empty for it). Dropping it rather than forwarding a level the backend does not honour." >&2
    fi
    EFFORT=""
elif [[ -z "$EFFORT" ]]; then
    EFFORT="${BACKEND_EFFORT[$BACKEND]}"
fi
if [[ -n "$EFFORT" && ! "$EFFORT" =~ ^(low|medium|high|xhigh|max)$ ]]; then
    echo "[ERROR] Invalid --effort '$EFFORT'. Use: low, medium, high, xhigh, max." >&2
    exit 1
fi

# ── Resolve timeout (per-backend default unless --timeout given) ─────────
# ALL backends run long-horizon agentic work — deep/glm/sonnet alike can run for
# an hour or more on a real multi-phase task. Never cap a long-horizon worker low;
# the wall-clock floor is generous and --timeout overrides for the rare short job.
if [[ -z "$TIMEOUT" ]]; then
    TIMEOUT=7200000   # 120 min — long-horizon ceiling for every backend
fi

# ── Resolve output ──────────────────────────────────────────────────────
if [[ -z "$OUTPUT_FILE" ]]; then
    TIMESTAMP=$(date +%Y%m%d-%H%M%S)
    OUTPUT_FILE="/tmp/claude-headless-${BACKEND}-${TIMESTAMP}-$$.json"
fi

# ── Worker guard + manifest hooks (concurrency safety) ───────────────────
# The headless worker is a SEPARATE `claude -p` process — it does NOT inherit
# this project's plugin hooks. Inject two hooks via --settings so worker
# behaviour is mechanically constrained no matter the --permission-mode:
#   • PreToolUse Bash  → worker-git-guard.sh — workers may stage explicit paths
#     and create local commits, but broad staging, destructive/history git and
#     remote operations are blocked. A PreToolUse deny fires
#     even under bypassPermissions (hooks are a separate layer from the
#     permission engine), which --disallowedTools is not guaranteed to be.
#   • PostToolUse Edit|Write|MultiEdit → worker-manifest-record.sh — appends
#     each touched path to MANIFEST_FILE for conductor audit/recovery. The
#     worker normally stages exactly its own paths and commits before return.
# Both hooks self-gate on META_WORKER_MANIFEST, so they're no-ops anywhere else.
MANIFEST_FILE="${OUTPUT_FILE}.manifest.jsonl"
WORKER_SETTINGS_FILE="${OUTPUT_FILE}.worker-settings.json"
HOOKS_DIR="$PLUGIN_ROOT/hooks/scripts"
: > "$MANIFEST_FILE"   # start empty so the conductor always finds the file
python3 - "$WORKER_SETTINGS_FILE" "$HOOKS_DIR" <<'PYEOF'
import json, sys
settings_file, hooks_dir = sys.argv[1], sys.argv[2]
def cmd(name):
    return {"type": "command", "command": f'bash "{hooks_dir}/{name}"', "timeout": 10}
json.dump({
    "hooks": {
        "PreToolUse":  [{"matcher": "Bash",              "hooks": [cmd("worker-git-guard.sh")]}],
        "PostToolUse": [{"matcher": "Edit|Write|MultiEdit", "hooks": [cmd("worker-manifest-record.sh")]}],
    }
}, open(settings_file, "w"))
PYEOF

# ── GLM beta-strip proxy ────────────────────────────────────────────────
# Z.AI's /api/anthropic rejects ANY request carrying an `anthropic-beta`
# header with [1302] "Rate limit reached". Claude Code always sends a
# non-empty anthropic-beta (4+ core betas are NOT suppressible via env
# vars), so a headless `claude -p` GLM worker deterministically fails —
# [1302] retried 10x (~210s) then surfaced as a 529. For the GLM backend we
# stand up a local proxy (scripts/glm-beta-strip-proxy.py) that deletes
# `anthropic-beta` + the `?beta=true` query param before forwarding to Z.AI.
# DeepSeek and Sonnet are unaffected (their endpoints tolerate the header).
GLM_PROXY_PID=""
if [[ "$BACKEND" == "glm" ]]; then
    GLM_PROXY_PORT="$(python3 -c 'import socket;s=socket.socket();s.bind(("127.0.0.1",0));print(s.getsockname()[1]);s.close()' 2>/dev/null)"
    if [[ -n "$GLM_PROXY_PORT" ]]; then
        python3 "$SCRIPT_DIR/glm-beta-strip-proxy.py" "$GLM_PROXY_PORT" >/dev/null 2>&1 &
        GLM_PROXY_PID=$!
        for _ in $(seq 1 20); do                      # wait for the port to accept (~5s)
            (exec 3<>/dev/tcp/127.0.0.1/"$GLM_PROXY_PORT") 2>/dev/null && break
            sleep 0.25
        done
        BACKEND_BASE_URL[glm]="http://127.0.0.1:$GLM_PROXY_PORT"
    else
        echo "[claude-headless-exec] WARN: could not allocate a proxy port; routing GLM direct to Z.AI (workers will likely 529)." >&2
    fi
fi
cleanup_glm_proxy() { [[ -n "$GLM_PROXY_PID" ]] && kill "$GLM_PROXY_PID" 2>/dev/null; return 0; }

# ── Scope claim + unified EXIT cleanup (cross-session concurrency safety) ─
# When --claim <scope> is given, claim that plan-directory in the shared
# registry BEFORE dispatching, so two sessions can't race the same files
# (incident 2026-07-05). The claim is stamped with THIS wrapper's pid ($$),
# which lives exactly as long as the worker — so it auto-expires the instant
# this process dies, and is explicitly released on EXIT. If the scope is held
# by another LIVE session we ABORT (do not dispatch) unless --claim-warn.
WORKER_CLAIM_SH="$SCRIPT_DIR/worker-claim.sh"
CLAIM_HELD=false
cleanup_all() {
    [[ "${CLAIM_HELD:-false}" == "true" ]] && bash "$WORKER_CLAIM_SH" release "$CLAIM_SCOPE" >/dev/null 2>&1 || true
    cleanup_glm_proxy
    # NEVER let the EXIT trap's last status override the script's real exit code:
    # under `set -e`, a trap that ends nonzero forces exit 1. The old
    # `trap cleanup_glm_proxy EXIT` did exactly that on deep/sonnet (empty
    # GLM_PROXY_PID → `[[ -n "" ]]` returns 1), so those backends exited 1 on
    # SUCCESS — the dominant source of the spurious exit-1, and it would mask
    # the is_error→exit-0 reconcile above. Anchoring the trap at 0 fixes both.
    return 0
}
trap cleanup_all EXIT
if [[ -n "$CLAIM_SCOPE" ]]; then
    if bash "$WORKER_CLAIM_SH" claim "$CLAIM_SCOPE" --pid "$$" --session "${CLAUDE_SESSION_ID:-$$}"; then
        CLAIM_HELD=true
    elif [[ "$CLAIM_WARN" == "true" ]]; then
        echo "[claude-headless-exec] WARN: scope '$CLAIM_SCOPE' is held by another live session — proceeding anyway (--claim-warn)." >&2
    else
        echo "[claude-headless-exec] ABORT: scope '$CLAIM_SCOPE' is held by another live session; not dispatching." >&2
        echo "        Partition by directory, wait for release, or pass --claim-warn to override." >&2
        exit 3
    fi
fi

# ── Build env ───────────────────────────────────────────────────────────
# These vars are applied to the child process only (via env(1)); the parent
# shell's environment is never mutated.
ENV_VARS=(
    "ANTHROPIC_DEFAULT_OPUS_MODEL=${BACKEND_OPUS_MODEL[$BACKEND]}"
    "ANTHROPIC_DEFAULT_SONNET_MODEL=${BACKEND_SONNET_MODEL[$BACKEND]}"
    "ANTHROPIC_DEFAULT_HAIKU_MODEL=${BACKEND_HAIKU_MODEL[$BACKEND]}"
    "CLAUDE_CODE_SUBAGENT_MODEL=${BACKEND_SUBAGENT_MODEL[$BACKEND]}"
    "API_TIMEOUT_MS=${TIMEOUT}"
    "META_WORKER_MANIFEST=${MANIFEST_FILE}"   # arms worker-git-guard + worker-manifest-record hooks
)
ENV_UNSET=()

if [[ -z "${BACKEND_BASE_URL[$BACKEND]}" ]]; then
    # Ambient Anthropic backends (sonnet / opus / fable) — REAL Anthropic via the
    # Ambient Claude login. An empty base URL is the marker: do NOT set a base URL or
    # auth token. Scrub any inherited 3rd-party routing (e.g. if this runs from a
    # shell that was pointed at deep/glm) so the model can't be proxied off to the
    # wrong backend. The pinned 5-family model runs 1M at standard rates (no
    # premium above 200K), so there is no billing tier to manage here.
    ENV_UNSET=(-u ANTHROPIC_BASE_URL -u ANTHROPIC_AUTH_TOKEN -u ANTHROPIC_API_KEY)
else
    # deep / glm route through a 3rd-party Anthropic-compatible endpoint.
    ENV_VARS+=(
        "ANTHROPIC_BASE_URL=${BACKEND_BASE_URL[$BACKEND]}"
        "ANTHROPIC_AUTH_TOKEN=${AUTH_KEY}"
    )
fi

# Thinking/reasoning effort — resolved per-backend above (see BACKEND_EFFORT)
# or overridden with --effort. Empty means "leave the CLI default alone".
# NOTE: this is process-wide, so it also covers the worker's Haiku-tier calls
# (ANTHROPIC_DEFAULT_HAIKU_MODEL). That is safe — Claude Code gates effort
# per-model and drops it for Haiku 4.5, verified 2026-07-24 (a haiku-4-5 run
# with CLAUDE_CODE_EFFORT_LEVEL=high returned api_error_status:null / success).
# The *API* output_config.effort param does reject Haiku 4.5; the env var does not.
if [[ -n "$EFFORT" ]]; then
    ENV_VARS+=(
        "CLAUDE_CODE_EFFORT_LEVEL=${EFFORT}"
    )
fi

# ── Dashboard ───────────────────────────────────────────────────────────
if [[ -n "$AUTH_KEY" ]]; then
    MASKED_KEY="${AUTH_KEY:0:5}...${AUTH_KEY: -4}"
else
    MASKED_KEY="(ambient Claude login)"
fi
BACKEND_LABEL="${BACKEND_LABEL[$BACKEND]}"

cat <<EOF

╔══════════════════════════════════════════════════════════════════════════╗
║  HEADLESS EXECUTION — $BACKEND_LABEL
╠══════════════════════════════════════════════════════════════════════════╣
║  Backend   : ${BACKEND_LABEL}
║  Model     : ${MODEL}
║  Effort    : ${EFFORT:-"(CLI default)"}
║  Repo      : ${REPO}
║  Work Dir  : ${WORK_DIR}
║  Resolved  : ${WORKDIR_ORIGIN}
║  Tools     : ${TOOLS}
║  Timeout   : ${TIMEOUT}ms
║  Budget    : ${MAX_BUDGET_USD:-\$unlimited}
║  Output    : ${OUTPUT_FILE}
║  Auth Key  : ${MASKED_KEY}
╠══════════════════════════════════════════════════════════════════════════╣
║  Task:
║    ${PROMPT:0:70}...
╚══════════════════════════════════════════════════════════════════════════╝

EOF

# ── Execute ─────────────────────────────────────────────────────────────
echo "[claude-headless-exec] Starting headless Claude Code on $BACKEND_LABEL..."
echo "[claude-headless-exec] Working directory: $WORK_DIR"
echo "[claude-headless-exec] Output file: $OUTPUT_FILE"
echo ""

# Keep the full raw transcript and stderr separate from the clean result so
# OUTPUT_FILE stays a single parseable JSON object the caller can json.load().
RAW_FILE="${OUTPUT_FILE}.raw"
STDERR_FILE="${OUTPUT_FILE}.stderr"

START_TIME=$(date +%s)

# Run headless Claude Code with the backend-specific env vars.
# env(1) sets vars for just this child process — no shell-state leak.
#   --no-session-persistence            Don't clutter the session resume list
#   --permission-mode bypassPermissions Trust the --allowedTools gate
# stdout (the JSON payload) → RAW_FILE ; stderr (warnings) → STDERR_FILE.
# Keeping the two streams apart is what makes OUTPUT_FILE cleanly parseable.
cd "$WORK_DIR"

PROMPT="HARD WORKER PERSISTENCE RULE (binding): If you edit any scoped file,
stage only those exact paths and create a LOCAL commit before every return,
including red verification, failed review, BLOCKED, or exhausted repair. Red
blocks DONE/checkbox/remote push, never the local commit. Never push, pull, or
rebase; the conductor owns the remote. Read-only work creates no empty commit.

${PROMPT}"

# ── Output-format-aware liveness config ──────────────────────────────────
# The stall-watchdog spots a hung worker by watching the RAW file stop GROWING.
# That signal is only meaningful when the worker STREAMS events (stream-json): a
# buffered `--output-format json` run writes NOTHING until the final flush, so a
# healthy run longer than STALL_SECS sits frozen at 0B and gets false-killed
# (exit 125 after the reset budget). So:
#   • stream-json  → arm `--verbose` (the CLI requires it) and keep the watchdog.
#   • any other fmt (buffered json / text) → disable the growth-watchdog unless the
#     caller explicitly set STALL_SECS; the 120-min timeout(1) cap still backstops.
STREAM_FLAGS=()
if [[ "$OUTPUT_FORMAT" == "stream-json" ]]; then
    STREAM_FLAGS+=(--verbose)
else
    STALL_SECS="${STALL_SECS:-0}"
fi

# Liveness watchdog: if the worker's RAW stream goes silent (hangs) we kill +
# auto-reset it, rather than wait out the full 120-min cap. See lib/stall-watchdog.sh.
source "$SCRIPT_DIR/lib/stall-watchdog.sh"
stall_launch_worker() {
    env "${ENV_UNSET[@]+"${ENV_UNSET[@]}"}" "${ENV_VARS[@]}" \
        claude -p "$PROMPT" \
            --output-format "$OUTPUT_FORMAT" \
            "${STREAM_FLAGS[@]+"${STREAM_FLAGS[@]}"}" \
            --model "$MODEL" \
            --allowedTools "$TOOLS" \
            --settings "$WORKER_SETTINGS_FILE" \
            --no-session-persistence \
            --permission-mode bypassPermissions \
            ${MAX_TURNS:+--max-turns "$MAX_TURNS"} \
            ${MAX_BUDGET_USD:+--max-budget-usd "$MAX_BUDGET_USD"} \
            > "$RAW_FILE" 2> "$STDERR_FILE" &
    WORKER_PID=$!
}

run_with_stall_watchdog
EXIT_CODE=$STALL_EXIT

END_TIME=$(date +%s)
ELAPSED=$((END_TIME - START_TIME))

# ── Distill RAW → clean result ──────────────────────────────────────────
# claude --output-format json may emit a single {type:result,...} object OR a
# JSON array of all stream events, sometimes behind a leading warning line.
# The distiller normalizes that to a compact result object written to
# OUTPUT_FILE and echoes the result text (which we capture for the summary).
RESULT_TEXT=""
IS_ERROR="unknown"
PARSE_OK=false
if [[ "$OUTPUT_FORMAT" == "json" || "$OUTPUT_FORMAT" == "stream-json" ]]; then
    if RESULT_TEXT=$(python3 "$SCRIPT_DIR/lib/distill-headless-result.py" "$RAW_FILE" "$OUTPUT_FILE" 2>>"$STDERR_FILE"); then
        PARSE_OK=true
        IS_ERROR=$(python3 -c "import json,sys; print(json.load(open(sys.argv[1])).get('is_error'))" "$OUTPUT_FILE" 2>/dev/null || echo unknown)
    fi
fi
if [[ "$PARSE_OK" != "true" ]]; then
    # Text output mode, or JSON distill failed — fall back to raw verbatim.
    cp "$RAW_FILE" "$OUTPUT_FILE"
    if [[ "$OUTPUT_FORMAT" == "json" || "$OUTPUT_FORMAT" == "stream-json" ]]; then
        RESULT_TEXT="[distill failed — inspect raw payload: $RAW_FILE / stderr: $STDERR_FILE]"
        [[ $EXIT_CODE -eq 0 ]] && EXIT_CODE=3
    else
        RESULT_TEXT="$(cat "$RAW_FILE")"
    fi
fi

# A model that ran but reported is_error:true should not look like success.
if [[ "$IS_ERROR" == "True" && $EXIT_CODE -eq 0 ]]; then
    EXIT_CODE=4
fi

# Stall-halt: worker went silent through the whole reset budget — surface loudly
# (distinct exit 125) so the conductor PAUSES rather than trusting the silence.
if [[ "${STALL_HALTED:-false}" == "true" ]]; then
    IS_ERROR="True"
    RESULT_TEXT="[STALLED — worker produced no output for $(( ${STALL_SECS:-300} / 60 ))m, killed and re-dispatched ${STALL_RESETS}× then HALTED. Run PAUSED for review. Partial trace: $RAW_FILE]"
fi

# ── Honest exit code ─────────────────────────────────────────────────────
# A cleanly-distilled result that reports is_error:false IS a success — even
# when the worker *process* returned a nonzero raw code. `claude -p` has a
# long-standing quirk where the model finishes fine (is_error:false) yet the
# process still exits nonzero, so conductors couldn't trust the exit code to
# tell success from failure. Reconcile DOWN to 0 here so they can.
#
# Guarded so a REAL failure is never masked: a distill miss (PARSE_OK=false,
# already → EXIT_CODE=3), a model-reported error (IS_ERROR=True → 4), or a
# stall-halt (IS_ERROR forced True → 125) each keep their nonzero code because
# this branch requires PARSE_OK=true AND IS_ERROR=False AND not stall-halted.
if [[ "$PARSE_OK" == "true" && "$IS_ERROR" == "False" && "${STALL_HALTED:-false}" != "true" && $EXIT_CODE -ne 0 ]]; then
    echo "[claude-headless-exec] worker process exited $EXIT_CODE but result is_error:false — reconciling exit code to 0 (success)."
    EXIT_CODE=0
fi

# ── Result summary ──────────────────────────────────────────────────────
echo ""
echo "────────────────────────────────────────────────────────────────────────"
echo "  HEADLESS EXECUTION COMPLETE"
echo "────────────────────────────────────────────────────────────────────────"
echo "  Backend   : $BACKEND_LABEL ($MODEL)"
echo "  Exit code : $EXIT_CODE"
echo "  is_error  : $IS_ERROR"
echo "  Elapsed   : ${ELAPSED}s"
[[ "${STALL_RESETS:-0}" -gt 0 ]] && echo "  Stalls    : ${STALL_RESETS} auto-reset(s)$([[ "${STALL_HALTED:-false}" == "true" ]] && echo " → HALTED (paused for review)")"
echo "  Result    : $OUTPUT_FILE   (clean JSON — result/is_error/turns)"
MANIFEST_COUNT=$([ -s "$MANIFEST_FILE" ] && wc -l < "$MANIFEST_FILE" | tr -d ' ' || echo 0)
echo "  Manifest  : $MANIFEST_FILE   (${MANIFEST_COUNT} touched-file record(s) — conductor stages EXACTLY these)"
echo "  Raw trace : $RAW_FILE"
echo "  Stderr    : $STDERR_FILE"
echo "────────────────────────────────────────────────────────────────────────"

if [[ $EXIT_CODE -ne 0 ]]; then
    echo ""
    echo "[WARN] Headless execution exit code $EXIT_CODE (is_error=$IS_ERROR)."
    echo "       Inspect: $STDERR_FILE"
fi

# ── Surface the distilled result text for the orchestrator ──────────────
echo ""
echo "════════════════════════ RESULT ════════════════════════════════════════"
printf '%s\n' "$RESULT_TEXT"
echo "═════════════════════════════════════════════════════════════════════════"
# Machine-parseable trailer (last line stays OUTPUT_FILE for back-compat).
echo "MANIFEST_FILE=$MANIFEST_FILE"
echo "OUTPUT_FILE=$OUTPUT_FILE"

exit $EXIT_CODE
